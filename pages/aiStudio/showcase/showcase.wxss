/* 场景模拟 · Editorial 纸面化外围（品牌令牌 --pm-*）+ 六款纯 CSS 实景
   外围 chrome 一律 var() 引用令牌；场景内部墙面/木色/深棕/水晶/金属为
   实物拟真色系（非品牌令牌），主要色已抽成页面级 --pm-scene-* 变量，
   其余一次性实物色以字面量保留并注释标明。 */

.showcase-page {
  /* ---- 实物色系（场景拟真，非品牌令牌）---- */
  --pm-scene-wall: #f8f3ea;        /* 米白墙面 */
  --pm-scene-wall-deep: #e9dfcc;   /* 墙面近地投影 */
  --pm-scene-wood: #c9a075;        /* 木色桌面 */
  --pm-scene-wood-deep: #b0855c;   /* 桌面暗部 */
  --pm-scene-frame: #5d4037;       /* 深棕画框 */
  --pm-scene-frame-light: #7b5a4f; /* 画框受光面 */
  --pm-scene-leather: #6d4c41;     /* 皮革（钱包/书脊） */
  --pm-scene-leather-deep: #4e342e;
  --pm-scene-metal: #9aa2ab;       /* 金属件（挂环） */
  --pm-scene-cord: #8d6e63;        /* 挂绳/挂线 */
  --pm-scene-paper: #fffdf9;       /* 挂历纸 */

  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: var(--pm-bg);
}

/* ===== 刊头 ===== */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid var(--pm-hairline);
}

.back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-primary);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.nav-title {
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.nav-spacer {
  width: 108rpx;
  flex-shrink: 0;
}

/* 提示条：纸面便签 + 品牌蓝侧线 */
.hint-bar {
  margin-bottom: 24rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--pm-hairline);
  border-left: 6rpx solid var(--pm-primary);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ===== 纸面卡 + № 编号区块头 ===== */
.panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

.sec-head {
  display: flex;
  align-items: baseline;
  padding-bottom: 16rpx;
  margin-bottom: 22rpx;
  border-bottom: 2rpx solid var(--pm-hairline);
}

.sec-no {
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--pm-primary);
}

.sec-num {
  margin-left: 8rpx;
  font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--pm-ink-3);
}

.sec-dot {
  margin: 0 12rpx;
  font-size: 24rpx;
  color: var(--pm-ink-4);
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--pm-ink);
}

/* ===== №01 品类切换条：直角小方签 ===== */
.chip-bar {
  width: 100%;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
}

.chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 26rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

.chip-name {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--pm-ink);
}

.chip-price {
  margin-top: 6rpx;
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 22rpx;
  color: var(--pm-ink-3);
}

.chip-active {
  border-color: var(--pm-primary);
  background: var(--pm-primary);
}

.chip-active .chip-name {
  color: var(--pm-card);
}

.chip-active .chip-price {
  color: var(--pm-primary-soft);
}

/* ===== №02 场景模拟区 ===== */
.scene-card {
  padding: 28rpx;
}

/* 场景舞台：外围统一发丝边 + 直角 + 纸面投影 */
.scene-stage {
  position: relative;
  width: 100%;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius-card);
  overflow: hidden;
}

.scene-photo {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--pm-card-soft);
}

.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  background: var(--pm-card-soft);
}

.photo-empty-sm {
  font-size: 20rpx;
}

/* 场景说明：衬线斜体小字 */
.scene-caption {
  margin-top: 18rpx;
  text-align: center;
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--pm-ink-3);
}

/* --- 挂墙：客厅墙场景（实物色系，非品牌令牌） --- */
.scene-wall {
  height: 620rpx;
  background: linear-gradient(180deg, var(--pm-scene-wall) 0%, #f1e9da 70%, var(--pm-scene-wall-deep) 100%);
}

.wall-baseboard {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34rpx;
  background: #dccfb8; /* 实物色系，非品牌令牌：踢脚线 */
  border-top: 3rpx solid #cbbca0; /* 实物色系，非品牌令牌 */
  box-shadow: 0 -8rpx 14rpx rgba(93, 64, 55, 0.1); /* 实物投影 */
}

.wall-frame-group {
  position: absolute;
  left: 50%;
  top: 22rpx;
  transform: translateX(-50%) rotate(1deg);
}

.frame-nail {
  position: absolute;
  top: -30rpx;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  border-radius: 50%;
  background: var(--pm-scene-frame);
}

.frame-cord {
  position: absolute;
  top: -26rpx;
  width: 4rpx;
  height: 44rpx;
  border-radius: 2rpx;
  background: var(--pm-scene-cord);
  transform-origin: 50% 100%;
}

.cord-l {
  left: 18%;
  transform: rotate(24deg);
}

.cord-r {
  right: 18%;
  transform: rotate(-24deg);
}

.wall-frame {
  background: linear-gradient(145deg, var(--pm-scene-frame-light) 0%, var(--pm-scene-frame) 100%);
  padding: 14rpx;
  border-radius: 8rpx; /* 实物画框圆角 */
  box-shadow: 0 22rpx 44rpx rgba(62, 39, 35, 0.35); /* 实物投影 */
}

.frame-mat {
  background: #ffffff; /* 实物色系，非品牌令牌：卡纸白 */
  padding: 24rpx;
}

.size-8 .frame-mat .scene-photo {
  width: 240rpx;
  height: 300rpx;
}

.size-12 .wall-frame {
  padding: 18rpx;
}

.size-12 .frame-mat {
  padding: 30rpx;
}

.size-12 .frame-mat .scene-photo {
  width: 320rpx;
  height: 384rpx;
}

/* 沙发：灰布艺（实物色系，非品牌令牌） */
.sofa {
  position: absolute;
  bottom: 34rpx;
  left: 50%;
  width: 540rpx;
  height: 200rpx;
  transform: translateX(-50%);
}

.sofa-back {
  position: absolute;
  bottom: 56rpx;
  left: 70rpx;
  right: 70rpx;
  height: 118rpx;
  border-radius: 44rpx 44rpx 14rpx 14rpx;
  background: #c5cad2; /* 实物色系，非品牌令牌 */
}

.sofa-cushion {
  position: absolute;
  bottom: 112rpx;
  width: 160rpx;
  height: 62rpx;
  border-radius: 24rpx;
  background: #ced3da; /* 实物色系，非品牌令牌 */
}

.cushion-l {
  left: 96rpx;
}

.cushion-r {
  right: 96rpx;
}

.sofa-arm {
  position: absolute;
  bottom: 20rpx;
  width: 62rpx;
  height: 150rpx;
  border-radius: 31rpx;
  background: #adb3bd; /* 实物色系，非品牌令牌 */
}

.sofa-arm-l {
  left: 28rpx;
}

.sofa-arm-r {
  right: 28rpx;
}

.sofa-seat {
  position: absolute;
  bottom: 20rpx;
  left: 56rpx;
  right: 56rpx;
  height: 78rpx;
  border-radius: 16rpx;
  background: #b8bec7; /* 实物色系，非品牌令牌 */
}

.sofa-shadow {
  position: absolute;
  bottom: 12rpx;
  left: 64rpx;
  right: 64rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(62, 39, 35, 0.12); /* 实物投影 */
}

/* --- 摆台：桌面 + 水晶摆台（实物色系，非品牌令牌） --- */
.scene-desk {
  height: 620rpx;
  background: linear-gradient(180deg, #edf1f6 0%, #e8edf3 52%, var(--pm-scene-wood) 52%, var(--pm-scene-wood) 100%);
}

.desk-surface {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 300rpx;
  background: linear-gradient(180deg, var(--pm-scene-wood) 0%, #bd8f66 60%, var(--pm-scene-wood-deep) 100%); /* #bd8f66 实木过渡色，非品牌令牌 */
  clip-path: polygon(3% 0, 97% 0, 100% 100%, 0 100%);
}

.desk-grain {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 300rpx;
  clip-path: polygon(3% 0, 97% 0, 100% 100%, 0 100%);
  background-image: repeating-linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.06) 0,
    rgba(255, 255, 255, 0.06) 3rpx,
    transparent 3rpx,
    transparent 64rpx
  ); /* 实物木纹 */
}

.stand-group {
  position: absolute;
  bottom: 86rpx;
  left: 50%;
  transform: translateX(-50%);
}

.stand-base-shadow {
  position: absolute;
  bottom: -18rpx;
  left: 50%;
  width: 320rpx;
  height: 40rpx;
  margin-left: -160rpx;
  border-radius: 50%;
  background: rgba(62, 39, 35, 0.28); /* 实物投影 */
}

.stand-piece {
  position: relative;
  transform: perspective(900rpx) rotateX(8deg);
}

.desk-photo-card {
  background: #ffffff; /* 实物色系，非品牌令牌：相纸白 */
  padding: 16rpx;
  box-shadow: 0 16rpx 34rpx rgba(62, 39, 35, 0.3); /* 实物投影 */
}

.desk-photo {
  width: 250rpx;
  height: 350rpx;
}

/* 水晶高光（实物色系，非品牌令牌） */
.crystal-panel {
  position: absolute;
  top: -8rpx;
  bottom: -14rpx;
  left: -14rpx;
  right: -14rpx;
  border-radius: 4rpx;
  clip-path: polygon(9% 0, 91% 0, 100% 100%, 0 100%);
  background: linear-gradient(
    155deg,
    rgba(255, 255, 255, 0.6) 0%,
    rgba(255, 255, 255, 0.1) 42%,
    rgba(255, 255, 255, 0.06) 70%,
    rgba(255, 255, 255, 0.32) 100%
  );
}

.crystal-shine {
  position: absolute;
  top: 6%;
  left: 16%;
  width: 20rpx;
  height: 72%;
  border-radius: 12rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0));
  transform: rotate(16deg);
}

.crystal-base {
  position: absolute;
  bottom: -24rpx;
  left: 50%;
  width: 230rpx;
  height: 20rpx;
  margin-left: -115rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.35));
  box-shadow: 0 8rpx 14rpx rgba(62, 39, 35, 0.2); /* 实物投影 */
}

/* --- 挂历：照片 + 13 个月历点阵（实物色系，非品牌令牌） --- */
.scene-calendar {
  height: auto;
  overflow: visible;
  padding: 46rpx 0 40rpx;
  background: linear-gradient(180deg, #e9eef4 0%, #dfe7f0 100%); /* 实物色系，非品牌令牌：桌面冷灰背景 */
  display: flex;
  justify-content: center;
}

.calendar-card {
  position: relative;
  width: 500rpx;
  background: var(--pm-scene-paper);
  border-radius: 14rpx; /* 实物纸品圆角 */
  box-shadow: 0 22rpx 46rpx rgba(31, 45, 61, 0.18); /* 实物投影 */
  transform: rotate(0.6deg);
  padding-bottom: 8rpx;
}

.cal-ring {
  position: absolute;
  top: -20rpx;
  width: 34rpx;
  height: 34rpx;
  border: 8rpx solid #97a1ac; /* 实物色系，非品牌令牌：装订环 */
  border-radius: 50%;
  box-sizing: border-box;
}

.ring-l {
  left: 110rpx;
}

.ring-r {
  right: 110rpx;
}

.cal-photo {
  display: block;
  width: 452rpx;
  height: 620rpx;
  margin: 26rpx auto 0;
  border-radius: 10rpx;
  background: var(--pm-card-soft);
}

.cal-range {
  margin: 14rpx 0 4rpx;
  text-align: center;
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--pm-ink-3);
}

.cal-months {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  padding: 8rpx 20rpx 14rpx;
}

.cal-month {
  border-top: 2rpx solid #e8e2d6; /* 实物色系，非品牌令牌：挂历分隔线 */
  padding-top: 4rpx;
}

.cal-month-name {
  text-align: center;
  color: var(--pm-ink-2);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}

.cal-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 2rpx;
}

.cal-week text {
  text-align: center;
  color: var(--pm-ink-3);
  font-size: 13rpx;
  line-height: 1.4;
}

.cal-dots {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 4rpx;
  margin-top: 4rpx;
}

.cal-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #546e7a; /* 实物色系，非品牌令牌：挂历印刷点 */
  justify-self: center;
}

.cal-dot.blank {
  background: transparent;
}

/* --- 钱包照：钱包 + 6 张小卡（实物色系，非品牌令牌） --- */
.scene-wallet {
  height: 620rpx;
  background: linear-gradient(180deg, #f3f0ea 0%, #e9e3d7 100%); /* 实物色系，非品牌令牌：亚麻桌面 */
}

.wallet {
  position: absolute;
  left: 26rpx;
  bottom: 150rpx;
  width: 300rpx;
  height: 236rpx;
  border-radius: 26rpx; /* 实物皮具圆角 */
  background: linear-gradient(160deg, var(--pm-scene-leather) 0%, var(--pm-scene-leather-deep) 100%);
  box-shadow: 0 18rpx 36rpx rgba(62, 39, 35, 0.35); /* 实物投影 */
}

.wallet-flap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 92rpx;
  border-radius: 26rpx 26rpx 0 0;
  background: rgba(0, 0, 0, 0.16); /* 实物皮革压盖 */
}

.wallet-stitch {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.35); /* 实物缝线 */
  border-radius: 18rpx;
}

.wallet-clasp {
  position: absolute;
  top: 76rpx;
  left: 50%;
  width: 56rpx;
  height: 28rpx;
  margin-left: -28rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #dcc699, #b49a6c); /* 实物色系，非品牌令牌：黄铜扣 */
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.25); /* 实物投影 */
}

.wallet-cards {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.wallet-card {
  position: absolute;
  box-sizing: border-box;
  width: 150rpx;
  height: 114rpx;
  padding: 8rpx;
  border-radius: 8rpx; /* 实物小卡圆角 */
  background: #ffffff; /* 实物色系，非品牌令牌：相纸白 */
  box-shadow: 0 8rpx 16rpx rgba(31, 45, 61, 0.2); /* 实物投影 */
  overflow: hidden;
}

.wcard-0 {
  right: 170rpx;
  bottom: 240rpx;
  transform: rotate(-9deg);
  z-index: 6;
}

.wcard-1 {
  right: 64rpx;
  bottom: 256rpx;
  transform: rotate(7deg);
  z-index: 5;
}

.wcard-2 {
  right: 190rpx;
  bottom: 148rpx;
  transform: rotate(5deg);
  z-index: 4;
}

.wcard-3 {
  right: 88rpx;
  bottom: 132rpx;
  transform: rotate(-6deg);
  z-index: 3;
}

.wcard-4 {
  right: 168rpx;
  bottom: 58rpx;
  transform: rotate(9deg);
  z-index: 2;
}

.wcard-5 {
  right: 58rpx;
  bottom: 44rpx;
  transform: rotate(-4deg);
  z-index: 1;
}

/* --- 亚克力挂件：一对圆形挂件（实物色系，非品牌令牌） --- */
.scene-pendant {
  height: 640rpx;
  background: linear-gradient(180deg, #eef3f8 0%, #e0e9f2 100%); /* 实物色系，非品牌令牌：冷灰背景 */
}

.pendant-group {
  position: absolute;
  top: 36rpx;
  width: 300rpx;
  height: 540rpx;
}

.pendant-a {
  left: 40rpx;
  transform: rotate(-4deg);
}

.pendant-b {
  right: 40rpx;
  transform: rotate(5deg);
}

.pendant-rope {
  position: absolute;
  top: 0;
  left: 50%;
  width: 4rpx;
  height: 148rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, #a1887f, var(--pm-scene-cord)); /* #a1887f 实物绳色，非品牌令牌 */
}

.pendant-ring {
  position: absolute;
  top: 138rpx;
  left: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  border: 7rpx solid var(--pm-scene-metal);
  border-radius: 50%;
  box-sizing: border-box;
}

.pendant-body {
  position: absolute;
  top: 192rpx;
  left: 50%;
  width: 264rpx;
  height: 264rpx;
  margin-left: -132rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9); /* 实物亚克力边缘 */
  border-radius: 50%;
  background: radial-gradient(
    circle at 34% 26%,
    rgba(255, 255, 255, 0.85) 0%,
    rgba(255, 255, 255, 0.28) 46%,
    rgba(255, 255, 255, 0.45) 100%
  ); /* 实物亚克力质感 */
  box-shadow: 0 18rpx 36rpx rgba(31, 45, 61, 0.16); /* 实物投影 */
}

.pendant-photo {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200rpx;
  height: 200rpx;
  margin: -100rpx 0 0 -100rpx;
  border: 6rpx solid #ffffff; /* 实物色系，非品牌令牌：白边 */
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--pm-card-soft);
}

.pendant-shine {
  position: absolute;
  top: 30rpx;
  left: 34rpx;
  width: 92rpx;
  height: 92rpx;
  border: 12rpx solid transparent;
  border-top-color: rgba(255, 255, 255, 0.9); /* 实物高光 */
  border-right-color: rgba(255, 255, 255, 0.55); /* 实物高光 */
  border-radius: 50%;
  transform: rotate(28deg);
}

/* --- 相册：摊开的跨页相册（实物色系，非品牌令牌） --- */
.scene-album {
  height: 640rpx;
  background: linear-gradient(180deg, #f6f1e8 0%, #eae2d3 100%); /* 实物色系，非品牌令牌：米色台面 */
}

.album-wrap {
  position: absolute;
  top: 84rpx;
  left: 50%;
  width: 600rpx;
  height: 470rpx;
  transform: translateX(-50%);
}

.album-depth {
  position: absolute;
  border-radius: 12rpx; /* 实物纸叠圆角 */
}

.depth-1 {
  top: 6rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -6rpx;
  background: #e6dfcf; /* 实物色系，非品牌令牌：内页边 */
}

.depth-2 {
  top: 12rpx;
  left: -9rpx;
  right: -9rpx;
  bottom: -12rpx;
  background: #d8cfb9; /* 实物色系，非品牌令牌：外页边 */
}

.album-spread {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  display: flex;
  border-radius: 12rpx; /* 实物纸品圆角 */
  background: #fdfbf6; /* 实物色系，非品牌令牌：内衬纸 */
  box-shadow: 0 18rpx 40rpx rgba(31, 45, 61, 0.22); /* 实物投影 */
  z-index: 2;
}

.album-page {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-left {
  border-radius: 12rpx 3rpx 3rpx 12rpx;
  box-shadow: inset -22rpx 0 26rpx -14rpx rgba(31, 45, 61, 0.22); /* 实物装订凹陷 */
}

.page-right {
  border-radius: 3rpx 12rpx 12rpx 3rpx;
  box-shadow: inset 22rpx 0 26rpx -14rpx rgba(31, 45, 61, 0.22); /* 实物装订凹陷 */
}

.album-photo-card {
  background: #ffffff; /* 实物色系，非品牌令牌：相纸白 */
  padding: 14rpx 14rpx 12rpx;
  border-radius: 4rpx;
  box-shadow: 0 8rpx 18rpx rgba(31, 45, 61, 0.12); /* 实物投影 */
}

.album-photo {
  width: 216rpx;
  height: 250rpx;
}

.album-caption {
  width: 150rpx;
  height: 8rpx;
  margin: 14rpx auto 0;
  border-radius: 4rpx;
  background: #e3ddd0; /* 实物色系，非品牌令牌：留白衬线 */
}

.album-spine {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 10rpx;
  margin-left: -5rpx;
  background: linear-gradient(
    90deg,
    rgba(31, 45, 61, 0) 0%,
    rgba(31, 45, 61, 0.38) 50%,
    rgba(31, 45, 61, 0) 100%
  ); /* 实物书沟 */
  z-index: 3;
}

.album-bookspine {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 210rpx;
  height: 30rpx;
  margin-left: -105rpx;
  border-radius: 8rpx 8rpx 12rpx 12rpx;
  background: linear-gradient(180deg, var(--pm-scene-leather), var(--pm-scene-leather-deep));
  box-shadow: 0 10rpx 18rpx rgba(62, 39, 35, 0.3); /* 实物投影 */
  z-index: 4;
}

/* --- 成片切换照片条：直角发丝边缩略 --- */
.photo-strip-wrap {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--pm-hairline);
}

.strip-title {
  margin-bottom: 14rpx;
  color: var(--pm-ink);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.photo-strip {
  width: 100%;
  white-space: nowrap;
}

.strip-row {
  display: inline-flex;
  align-items: center;
  padding-bottom: 20rpx;
}

.strip-item {
  position: relative;
  box-sizing: border-box;
  width: 120rpx;
  height: 120rpx;
  margin-right: 16rpx;
  border: 2rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  overflow: hidden;
  background: var(--pm-card-soft);
}

.strip-image {
  display: block;
  width: 100%;
  height: 100%;
}

/* 当前选中：品牌蓝 2rpx 描边 + 底部小三角（上指，位于缩略图内底边） */
.strip-active {
  border-color: var(--pm-primary);
}

.strip-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 0;
  height: 0;
  margin-left: -8rpx;
  border: 8rpx solid transparent;
  border-bottom: 8rpx solid var(--pm-primary);
}

/* 序号方签 */
.strip-no {
  position: absolute;
  left: 0;
  bottom: 0;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: 0;
  background: var(--pm-ink);
  color: var(--pm-card);
  font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.strip-active .strip-no {
  background: var(--pm-primary);
}

.strip-empty {
  display: inline-flex;
  align-items: center;
  height: 120rpx;
  color: var(--pm-ink-3);
  font-size: 25rpx;
}

/* ===== №03 已选清单：行式 ===== */
.cart-section {
  padding: 28rpx;
}

.empty-state {
  padding: 12rpx 0 4rpx;
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--pm-ink-3);
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.cart-thumb {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius);
  background: var(--pm-card-soft);
}

.cart-info {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.cart-name {
  color: var(--pm-ink);
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.cart-price {
  margin-top: 6rpx;
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 24rpx;
  color: var(--pm-ink-3);
}

/* qty 步进：方签化 */
.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  border: 2rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
  box-sizing: border-box;
}

.step-num {
  min-width: 56rpx;
  font-family: var(--pm-serif);
  color: var(--pm-ink);
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.cart-remove {
  margin-left: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--pm-radius);
  background: var(--pm-danger-soft);
  color: var(--pm-danger);
  font-size: 30rpx;
  line-height: 44rpx;
  text-align: center;
}

/* 合计：衬线大数字 */
.cart-total {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  padding-top: 22rpx;
  color: var(--pm-ink-2);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.cart-total-num {
  margin-left: 12rpx;
  font-family: var(--pm-serif);
  color: var(--pm-primary);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
}

/* ===== №04 提交：满宽直角品牌蓝 ===== */
.primary-btn {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: var(--pm-radius);
  background: var(--pm-primary);
  color: var(--pm-card);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.4;
  box-shadow: var(--pm-shadow-card);
}

.primary-btn::after {
  border: none;
}

.primary-btn[disabled] {
  background: var(--pm-ink-4);
  color: var(--pm-card);
  box-shadow: none;
}

.submit-btn {
  margin-top: 28rpx;
  letter-spacing: 8rpx;
}

.submit-hint {
  margin-top: 14rpx;
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 23rpx;
  text-align: center;
  color: var(--pm-ink-3);
}
