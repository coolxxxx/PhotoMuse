/* 订单详情 · Editorial 纸面视觉（颜色全部引用 app.wxss 设计令牌） */

.detail-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
  background: var(--pm-bg);
}

/* 顶部导航 */
.detail-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  min-height: 60rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-primary);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.nav-title {
  flex: 1;
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
}

.nav-spacer {
  width: 120rpx;
  flex-shrink: 0;
}

/* 纸面卡片基底 */
.status-card,
.section {
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

/* 状态区：衬线状态词 + 方签徽章 + 四步骤条 */
.status-card {
  padding-bottom: 34rpx;
}

.status-kicker {
  margin-bottom: 14rpx;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.status-word {
  margin-bottom: 12rpx;
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}

.status-subtitle {
  margin-bottom: 22rpx;
  color: var(--pm-ink-2);
  font-size: 26rpx;
}

.st-badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--pm-primary);
  border-radius: 4rpx;
  background: var(--pm-soft);
  color: var(--pm-primary-deep);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.st-badge.st-success {
  border-color: var(--pm-success);
  background: var(--pm-success-soft);
  color: var(--pm-success);
}

.st-badge.st-danger {
  border-color: var(--pm-danger);
  background: var(--pm-danger-soft);
  color: var(--pm-danger);
}

.steps {
  display: flex;
  align-items: flex-start;
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--pm-hairline);
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 96rpx;
  flex-shrink: 0;
}

.step-dot {
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid var(--pm-ink-4);
  border-radius: 50%;
  background: var(--pm-card);
  box-sizing: border-box;
}

.step.is-done .step-dot,
.step.is-current .step-dot {
  border-color: var(--pm-primary);
  background: var(--pm-primary);
}

.step-label {
  color: var(--pm-ink-4);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.step.is-done .step-label {
  color: var(--pm-ink-2);
}

.step.is-current .step-label {
  color: var(--pm-primary);
  font-weight: 700;
}

.step-line {
  flex: 1;
  height: 2rpx;
  margin-top: 5rpx;
  background: var(--pm-hairline);
}

.step-line.is-passed {
  background: var(--pm-primary);
}

/* 区块头：№ · 标题 + 发丝线 */
.section-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding-bottom: 16rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.section-no {
  color: var(--pm-primary);
  font-family: var(--pm-serif);
  font-size: 30rpx;
  font-style: italic;
}

.section-head-dot {
  color: var(--pm-ink-4);
  font-size: 24rpx;
}

.section-title {
  color: var(--pm-ink);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

/* 订单信息：行式列表 */
.info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--pm-hairline);
  font-size: 26rpx;
}

.info-label {
  flex-shrink: 0;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.info-value {
  color: var(--pm-ink);
  text-align: right;
  word-break: break-all;
}

.mono {
  font-family: 'SF Mono', Menlo, Consolas, 'Courier New', monospace;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.review-note,
.hint,
.empty-state,
.query-mode-tip {
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.hint {
  margin-top: 12rpx;
}

.query-mode-tip {
  margin: 16rpx 0 4rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--pm-line);
  border-radius: 4rpx;
  background: var(--pm-soft);
  color: var(--pm-primary-deep);
}

.review-note {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--pm-warning);
  border-radius: 4rpx;
  background: var(--pm-warning-soft);
  color: var(--pm-warning);
}

/* 补拍上传：警示方签 + warning 横幅 */
.warn-banner {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 18rpx 0 22rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--pm-warning);
  border-radius: 4rpx;
  background: var(--pm-warning-soft);
}

.warn-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--pm-warning);
  border-radius: 4rpx;
  color: var(--pm-warning);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.warn-text {
  flex: 1;
  color: var(--pm-warning);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 上传 / 补拍宫格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.photo-item,
.photo-add {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  overflow: hidden;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 4rpx;
  background: var(--pm-card-soft);
}

.photo-item image {
  display: block;
  width: 100%;
  height: 100%;
}

.remove-photo {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: var(--pm-ink);
  color: var(--pm-card);
  line-height: 44rpx;
  text-align: center;
  font-size: 30rpx;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--pm-line);
  color: var(--pm-primary);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.add-plus {
  margin-bottom: 6rpx;
  font-size: 44rpx;
  line-height: 1;
}

/* 按钮 */
.primary-btn {
  margin-top: 26rpx;
  border: none;
  border-radius: var(--pm-radius);
  background: var(--pm-primary);
  color: var(--pm-card);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.primary-btn::after {
  border: none;
}

.secondary-btn {
  margin-top: 26rpx;
  border: 1rpx solid var(--pm-line);
  border-radius: 0;
  background: var(--pm-card);
  color: var(--pm-primary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.secondary-btn::after {
  border: none;
}

/* loading：纸面色 + 衬线 */
.loading {
  padding: 120rpx 0;
  background: var(--pm-bg);
  color: var(--pm-ink-3);
  font-family: var(--pm-serif);
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

/* 收款码：纸面卡 + 相纸式白边 */
.qr-section {
  background: var(--pm-card-soft);
  box-shadow: none;
}

.qr-polaroid {
  width: 440rpx;
  margin: 26rpx auto 0;
  padding: 18rpx 18rpx 8rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 4rpx;
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

.qr-image {
  display: block;
  width: 100%;
  height: 404rpx;
  background: var(--pm-card-soft);
}

.polaroid-caption {
  padding: 14rpx 0 12rpx;
  color: var(--pm-ink-2);
  font-family: var(--pm-serif);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  text-align: center;
}

.qr-note {
  margin-top: 20rpx;
  text-align: center;
}

.qr-legal {
  text-align: center;
}

/* 分主题网格预览选片 */
.theme-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.theme-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.theme-no {
  color: var(--pm-ink-3);
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.theme-name {
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 34rpx;
  font-weight: 700;
}

.theme-selected-badge {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border: 1rpx solid var(--pm-primary);
  border-radius: 4rpx;
  background: var(--pm-soft);
  color: var(--pm-primary-deep);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.grid-preview-wrap {
  margin-top: 4rpx;
}

.preview-polaroid {
  padding: 16rpx 16rpx 8rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 4rpx;
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

.grid-preview-image {
  display: block;
  width: 100%;
  height: 620rpx;
  background: var(--pm-card-soft);
}

.cell-hint {
  margin-top: 22rpx;
}

.cell-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.cell-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border: 1rpx solid var(--pm-hairline);
  background: var(--pm-card-soft);
  color: var(--pm-ink-2);
  font-family: var(--pm-serif);
  font-size: 30rpx;
  box-sizing: border-box;
}

.cell-item.selected {
  border-color: var(--pm-primary);
  background: var(--pm-primary);
  color: var(--pm-card);
}

/* 已选分镜（分主题分组） */
.selected-theme-block {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.selected-theme-block:last-child {
  border-bottom: none;
  padding-bottom: 6rpx;
}

.selected-theme-name {
  margin-bottom: 12rpx;
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 28rpx;
  font-weight: 700;
}

.selected-cells {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.selected-cell-badge {
  min-width: 56rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid var(--pm-primary);
  border-radius: 4rpx;
  background: var(--pm-soft);
  color: var(--pm-primary-deep);
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.selected-cells-tail {
  color: var(--pm-ink-3);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* 周边好物 */
.merch-wait-hint {
  margin-top: 12rpx;
}

.merch-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 20rpx;
}

.merch-card {
  display: flex;
  flex-direction: column;
  padding: 22rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 4rpx;
  background: var(--pm-card);
  box-sizing: border-box;
}

.merch-tag {
  align-self: flex-start;
  margin-bottom: 14rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--pm-line);
  border-radius: 4rpx;
  color: var(--pm-primary-deep);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.merch-name {
  color: var(--pm-ink);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.merch-desc {
  flex: 1;
  margin-top: 10rpx;
  color: var(--pm-ink-3);
  font-size: 23rpx;
  line-height: 1.55;
}

.merch-meta {
  margin-top: 10rpx;
  color: var(--pm-ink-4);
  font-size: 22rpx;
}

.merch-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--pm-hairline);
}

.merch-price {
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 32rpx;
  font-style: italic;
  font-weight: 700;
}

.merch-go {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--pm-primary);
  border-radius: 4rpx;
  background: var(--pm-primary);
  color: var(--pm-card);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* 已选周边清单 */
.merch-selected-list {
  margin-top: 6rpx;
}

.merch-selected-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.merch-item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.merch-item-qty {
  color: var(--pm-ink-3);
  font-size: 24rpx;
}

.merch-item-total {
  flex-shrink: 0;
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 28rpx;
  font-style: italic;
}

.merch-total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 22rpx 0 8rpx;
  color: var(--pm-ink-2);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.merch-total-value {
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 44rpx;
  font-weight: 700;
}

/* 物流进度提示：等宽小字（含快递单号） */
.merch-status-hint {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 4rpx;
  background: var(--pm-card-soft);
  color: var(--pm-ink-2);
  font-family: 'SF Mono', Menlo, Consolas, 'Courier New', monospace;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 交付图：拍立得白边 + Final 角标 */
.delivery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 24rpx;
}

.delivery-polaroid {
  position: relative;
  width: 200rpx;
  padding: 12rpx 12rpx 30rpx;
  border: 1rpx solid var(--pm-hairline);
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

.delivery-polaroid image {
  display: block;
  width: 174rpx;
  height: 174rpx;
  background: var(--pm-card-soft);
}

.final-mark {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  padding: 4rpx 10rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 4rpx;
  background: var(--pm-card);
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 20rpx;
  font-style: italic;
  letter-spacing: 1rpx;
}

/* 空态：纸面化 */
.empty-state {
  margin-top: 18rpx;
  padding: 56rpx 24rpx;
  border: 1rpx dashed var(--pm-hairline-strong);
  border-radius: 4rpx;
  background: var(--pm-card-soft);
  color: var(--pm-ink-3);
  font-size: 25rpx;
  text-align: center;
}
