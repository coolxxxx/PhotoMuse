.detail-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f9ff;
}

.detail-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1976d2;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(25, 118, 210, 0.08);
}

.nav-title {
  flex: 1;
  padding-right: 24rpx;
  color: #1f2d3d;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}

.status-card,
.section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(25, 118, 210, 0.08);
}

.status-card {
  background: linear-gradient(135deg, #1976d2, #43a047);
  color: #ffffff;
}

.status-title {
  margin-bottom: 10rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.status-subtitle {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  opacity: 0.88;
}

.status-pill {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 25rpx;
}

.section-title {
  margin-bottom: 20rpx;
  color: #1f2d3d;
  font-size: 32rpx;
  font-weight: 700;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2f7;
  color: #37474f;
  font-size: 27rpx;
}

.review-note,
.hint,
.empty-state,
.query-mode-tip {
  color: #607d8b;
  font-size: 26rpx;
  line-height: 1.55;
}

.query-mode-tip {
  margin: 8rpx 0 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  color: #1976d2;
  background: #e3f2fd;
}

.review-note {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  color: #e65100;
  background: #fff7ed;
}

.photo-grid,
.delivery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
}

.photo-item,
.photo-add,
.delivery-grid image {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #eef3f8;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.remove-photo {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.56);
  color: #ffffff;
  line-height: 42rpx;
  text-align: center;
  font-size: 32rpx;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #1976d2;
  font-size: 25rpx;
  border: 2rpx dashed #90caf9;
}

.add-plus {
  margin-bottom: 8rpx;
  font-size: 48rpx;
}

.primary-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #1976d2;
  color: #ffffff;
}

.loading {
  padding: 80rpx 0;
  color: #90a4ae;
  text-align: center;
  font-size: 28rpx;
}

/* 收款码 */
.qr-wrap {
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

.qr-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 20rpx;
  background: #eef3f8;
}

.qr-note {
  margin-top: 18rpx;
}

/* 分主题网格预览选片 */
.theme-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.theme-title {
  flex: 1;
  margin-bottom: 0;
}

.theme-selected-badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f5e9;
  color: #43a047;
  font-size: 24rpx;
  font-weight: 700;
}

.grid-preview-wrap {
  margin-top: 10rpx;
}

.grid-preview-image {
  width: 100%;
  height: 640rpx;
  border-radius: 20rpx;
  background: #eef3f8;
}

.grid-preview-tip {
  margin-top: 12rpx;
  text-align: center;
}

.cell-hint {
  margin-top: 20rpx;
}

.cell-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.cell-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background: #eef3f8;
  color: #37474f;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.cell-item.selected {
  border-color: #1976d2;
  background: #e3f2fd;
  color: #1976d2;
}

/* 已选分镜徽章（分主题分组） */
.selected-theme-block {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.selected-theme-block:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.selected-theme-name {
  margin-bottom: 12rpx;
  color: #1976d2;
  font-size: 27rpx;
  font-weight: 700;
}

.selected-cells {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
}

.selected-cell-badge {
  min-width: 56rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.selected-cells-tail {
  color: #607d8b;
  font-size: 26rpx;
}

/* 周边好物 */
.merch-wait-hint {
  margin-top: 12rpx;
}

.merch-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 20rpx;
}

.merch-card {
  display: flex;
  flex-direction: column;
  padding: 22rpx;
  border: 1rpx solid #e3f2fd;
  border-radius: 20rpx;
  background: #f8fbff;
  box-sizing: border-box;
}

.merch-tag {
  align-self: flex-start;
  margin-bottom: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 22rpx;
  font-weight: 700;
}

.merch-name {
  color: #1f2d3d;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.merch-desc {
  flex: 1;
  margin-top: 10rpx;
  color: #607d8b;
  font-size: 23rpx;
  line-height: 1.5;
}

.merch-meta {
  margin-top: 10rpx;
  color: #90a4ae;
  font-size: 22rpx;
}

.merch-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
}

.merch-price {
  color: #e65100;
  font-size: 30rpx;
  font-weight: 800;
}

.merch-go {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #1976d2;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

/* 已选周边清单 */
.merch-selected-list {
  margin-top: 6rpx;
}

.merch-selected-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.merch-item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.merch-item-qty {
  color: #607d8b;
  font-size: 24rpx;
}

.merch-item-total {
  flex-shrink: 0;
  color: #e65100;
  font-size: 28rpx;
  font-weight: 700;
}

.merch-total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
  color: #1f2d3d;
  font-size: 28rpx;
  font-weight: 700;
}

.merch-total-value {
  color: #e65100;
  font-size: 32rpx;
  font-weight: 800;
}

.merch-status-hint {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 25rpx;
  line-height: 1.5;
}
