<view class="detail-page" wx:if="{{order}}">
  <view class="detail-nav">
    <view class="back-btn" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">订单详情</view>
  </view>

  <view class="status-card">
    <view class="status-title">{{order.productName}}</view>
    <view class="status-subtitle">{{order.styleName}} · {{order.spec || order.usage}}</view>
    <view class="status-pill">{{order.statusText}}</view>
  </view>

  <view class="section">
    <view class="section-title">订单信息</view>
    <view class="info-row"><text>订单号</text><text>{{order.orderId}}</text></view>
    <view wx:if="{{queryMode}}" class="query-mode-tip">当前通过手机号和查询密码查看订单。</view>
    <view class="info-row"><text>照片审核</text><text>{{order.photoCheckText}}</text></view>
    <view class="info-row"><text>参考图</text><text>{{order.reference_photo_count || 0}} 张</text></view>
    <view class="info-row"><text>交付图</text><text>{{order.delivery_file_count || 0}} 张</text></view>
    <view wx:if="{{order.reviewNote}}" class="review-note">{{order.reviewNote}}</view>
  </view>

  <view class="section" wx:if="{{order.photo_check === 'need_retake'}}">
    <view class="section-title">补拍上传</view>
    <view class="hint">请按审核意见重新上传 1-3 张清晰正脸照，提交后会重新进入审核。</view>
    <view class="photo-grid">
      <view wx:for="{{retakePhotos}}" wx:key="tempFilePath" class="photo-item">
        <image src="{{item.tempFilePath}}" mode="aspectFill"></image>
        <view class="remove-photo" data-index="{{index}}" bindtap="removeRetakePhoto">×</view>
      </view>
      <view wx:if="{{retakePhotos.length < 3}}" class="photo-add" bindtap="chooseRetakePhotos">
        <view class="add-plus">＋</view>
        <view>补传照片</view>
      </view>
    </view>
    <button class="primary-btn" loading="{{isUploading}}" bindtap="submitRetakePhotos">提交补拍</button>
  </view>

  <view class="section">
    <view class="section-title">交付图</view>
    <view wx:if="{{deliveryUrls.length === 0}}" class="empty-state">
      暂未交付。审核通过后，运营会进行制作和质检。
    </view>
    <view wx:else class="delivery-grid">
      <image
        wx:for="{{deliveryUrls}}"
        wx:key="*this"
        src="{{item}}"
        data-url="{{item}}"
        bindtap="previewDelivery"
        mode="aspectFill"
      ></image>
    </view>
  </view>
</view>

<view class="loading" wx:else>加载订单中...</view>
