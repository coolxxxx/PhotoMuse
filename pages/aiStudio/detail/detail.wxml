<view class="detail-page" wx:if="{{order}}">
  <view class="detail-nav">
    <view class="back-btn" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">订单详情</view>
  </view>

  <view class="status-card">
    <view class="status-title">{{order.productName}}</view>
    <view class="status-subtitle">{{order.styleName}} · {{order.spec || order.usage}}</view>
    <view class="status-pill">{{order.statusText}}</view>
  </view>

  <view class="section">
    <view class="section-title">订单信息</view>
    <view class="info-row"><text>订单号</text><text>{{order.orderId}}</text></view>
    <view wx:if="{{queryMode}}" class="query-mode-tip">当前通过手机号和查询密码查看订单。</view>
    <view class="info-row"><text>照片审核</text><text>{{order.photoCheckText}}</text></view>
    <view class="info-row"><text>参考图</text><text>{{order.reference_photo_count || 0}} 张</text></view>
    <view class="info-row"><text>交付图</text><text>{{order.delivery_file_count || 0}} 张</text></view>
    <view wx:if="{{order.reviewNote}}" class="review-note">{{order.reviewNote}}</view>
  </view>

  <view class="section" wx:if="{{order.payment_status === 'unpaid' && paymentQR}}">
    <view class="section-title">扫码支付</view>
    <view class="qr-wrap">
      <image
        class="qr-image"
        src="{{paymentQR.url}}"
        mode="aspectFit"
        show-menu-by-long-press="{{true}}"
      ></image>
    </view>
    <view wx:if="{{paymentQR.note}}" class="hint qr-note">{{paymentQR.note}}</view>
    <view class="hint">支付后请备注订单号后四位，商家确认到账后订单状态会更新</view>
  </view>

  <view class="section" wx:if="{{order.payment_status === 'unpaid' && paymentChecked && !paymentQR}}">
    <view class="section-title">扫码支付</view>
    <view class="hint">商家暂未配置收款码，请联系客服</view>
  </view>

  <view class="section" wx:if="{{order.photo_check === 'need_retake'}}">
    <view class="section-title">补拍上传</view>
    <view class="hint">请按审核意见重新上传 1-3 张清晰正脸照，提交后会重新进入审核。</view>
    <view class="photo-grid">
      <view wx:for="{{retakePhotos}}" wx:key="tempFilePath" class="photo-item">
        <image src="{{item.tempFilePath}}" mode="aspectFill"></image>
        <view class="remove-photo" data-index="{{index}}" bindtap="removeRetakePhoto">×</view>
      </view>
      <view wx:if="{{retakePhotos.length < 3}}" class="photo-add" bindtap="chooseRetakePhotos">
        <view class="add-plus">＋</view>
        <view>补传照片</view>
      </view>
    </view>
    <button class="primary-btn" loading="{{isUploading}}" bindtap="submitRetakePhotos">提交补拍</button>
  </view>

  <!-- 分主题网格选片：每个主题独立预览 + 15 宫格（旧单主题订单只渲染一个主题） -->
  <block wx:if="{{order.product_type === 'portrait' && order.order_status === 'grid_preview'}}">
    <view
      class="section theme-section"
      wx:for="{{themes}}"
      wx:key="key"
      wx:for-item="theme"
      wx:for-index="themeIndex"
    >
      <view class="theme-head">
        <view class="section-title theme-title">主题 · {{theme.themeName}}</view>
        <view wx:if="{{theme.hasSelected}}" class="theme-selected-badge">已选 {{theme.selectedCells.length}} 张</view>
      </view>
      <view wx:if="{{theme.previewUrl}}" class="grid-preview-wrap">
        <image
          class="grid-preview-image"
          src="{{theme.previewUrl}}"
          mode="aspectFit"
          data-theme-index="{{themeIndex}}"
          bindtap="previewThemeGrid"
        ></image>
        <view class="hint grid-preview-tip">点击查看大图</view>
      </view>
      <view wx:else class="empty-state">该主题的网格预览图尚未上传，请稍后再查看。</view>
      <view class="hint cell-hint">请在 3x5 网格中点击选择分镜，本主题最多可选 {{theme.maxCells}} 个。</view>
      <view wx:if="{{theme.hasSelected}}" class="hint">该主题已选过，如需调整可改选后重新提交。</view>
      <view class="cell-grid">
        <view
          wx:for="{{gridCells}}"
          wx:key="*this"
          wx:for-item="cell"
          class="cell-item {{theme.selectedMap[cell] ? 'selected' : ''}}"
          data-theme-index="{{themeIndex}}"
          data-cell="{{cell}}"
          bindtap="toggleThemeCell"
        >{{cell}}</view>
      </view>
      <button
        class="primary-btn"
        loading="{{theme.submitting}}"
        data-theme-index="{{themeIndex}}"
        bindtap="submitThemeCells"
      >{{theme.hasSelected ? '重新选片' : '确认选片'}}</button>
    </view>
  </block>

  <view class="section" wx:if="{{order.product_type === 'portrait' && order.order_status === 'cell_selected' && selectedThemes.length}}">
    <view class="section-title">已选分镜</view>
    <view class="selected-theme-block" wx:for="{{selectedThemes}}" wx:key="key" wx:for-item="group">
      <view wx:if="{{group.themeName}}" class="selected-theme-name">{{group.themeName}}</view>
      <view class="selected-cells">
        <view wx:for="{{group.cells}}" wx:key="*this" wx:for-item="cell" class="selected-cell-badge">{{cell}}</view>
        <view class="selected-cells-tail">制作中</view>
      </view>
    </view>
  </view>

  <!-- 周边好物：已选片/已交付展示商品网格；已选周边后展示清单与制作/发货进度 -->
  <view class="section merch-section" wx:if="{{showMerch}}">
    <view class="section-title">周边好物</view>
    <block wx:if="{{merchMode === 'shop'}}">
      <view class="hint">成片还能做成实体周边，选好商品后进入搭配页挑选成片，由商家制作寄送。</view>
      <view wx:if="{{!hasPrintableFiles}}" class="hint merch-wait-hint">成片制作完成后即可搭配周边。</view>
      <view wx:if="{{isLoadingMerch}}" class="empty-state">周边清单加载中...</view>
      <view wx:elif="{{merchList.length === 0}}" class="empty-state">暂未上架周边商品，敬请期待。</view>
      <view wx:else class="merch-grid">
        <view class="merch-card" wx:for="{{merchList}}" wx:key="merchId" wx:for-item="merch">
          <view class="merch-tag">{{merch.categoryLabel}}</view>
          <view class="merch-name">{{merch.name}}</view>
          <view wx:if="{{merch.desc}}" class="merch-desc">{{merch.desc}}</view>
          <view wx:if="{{merch.ratioText}}" class="merch-meta">{{merch.ratioText}}</view>
          <view class="merch-foot">
            <view class="merch-price">¥{{merch.price}}</view>
            <view class="merch-go" data-merch="{{merch.merchId}}" bindtap="goMerchShowcase">去搭配</view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="merch-selected-list">
        <view class="merch-selected-item" wx:for="{{merchItems}}" wx:key="merchItemId" wx:for-item="merch">
          <view class="merch-item-main">
            <view class="merch-name">{{merch.name}}</view>
            <view class="merch-item-qty">数量 × {{merch.qty}}</view>
          </view>
          <view class="merch-item-total">¥{{merch.lineTotal}}</view>
        </view>
      </view>
      <view class="merch-total-row">
        <text>周边合计</text>
        <text class="merch-total-value">¥{{merchTotal}}</text>
      </view>
      <view class="merch-status-hint">{{merchStatusHint}}</view>
    </block>
  </view>

  <view class="section">
    <view class="section-title">交付图</view>
    <view wx:if="{{deliveryUrls.length === 0}}" class="empty-state">
      暂未交付。审核通过后，运营会进行制作和质检。
    </view>
    <view wx:else class="delivery-grid">
      <image
        wx:for="{{deliveryUrls}}"
        wx:key="*this"
        src="{{item}}"
        data-url="{{item}}"
        bindtap="previewDelivery"
        mode="aspectFill"
      ></image>
    </view>
  </view>
</view>

<view class="loading" wx:else>加载订单中...</view>
