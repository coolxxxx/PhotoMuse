/* pages/aiStudio/index.wxss —— PhotoMuse Editorial（品牌蓝 × 杂志纸面）
   全部色彩经 --pm-* 令牌引用，禁止直接写十六进制色值 */

/* ---------- 页面骨架 ---------- */

.studio-page {
  min-height: 100vh;
  padding: 0 36rpx 60rpx;
  box-sizing: border-box;
  background: var(--pm-bg);
}

.page-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
}

.nav-back {
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  padding-right: 8rpx;
  color: var(--pm-ink);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nav-title {
  flex: 1;
  padding-right: 24rpx;
  color: var(--pm-ink-3);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-align: center;
}

/* ---------- Hero：杂志刊头 ---------- */

.hero {
  padding: 76rpx 0 64rpx;
  text-align: center;
}

.hero-eyebrow {
  color: var(--pm-ink-3);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.hero-title {
  margin-top: 26rpx;
  font-family: var(--pm-serif);
  font-size: 100rpx;
  font-weight: 700;
  line-height: 1.12;
  color: var(--pm-ink);
}

.hero-rule {
  width: 60rpx;
  height: 3rpx;
  margin: 30rpx auto 24rpx;
  background: var(--pm-ink);
}

.hero-sub {
  color: var(--pm-ink-2);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* ---------- № 工序编号区块头 ---------- */

.pm-section {
  margin-top: 64rpx;
}

.pm-sec-head {
  position: relative;
  display: flex;
  align-items: baseline;
  padding-bottom: 16rpx;
}

.pm-sec-mark {
  font-family: var(--pm-serif);
  color: var(--pm-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.pm-sec-no {
  margin-left: 8rpx;
  font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.pm-sec-title {
  margin-left: 16rpx;
  color: var(--pm-ink);
  font-size: 34rpx;
  font-weight: 700;
}

.pm-sec-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2rpx;
  background: var(--pm-hairline);
}

/* ---------- №01 套餐：行式列表 ---------- */

.pm-product-list {
  margin-top: 4rpx;
  border-top: 1rpx solid var(--pm-hairline);
}

.pm-product-row {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 8rpx 30rpx 36rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.pm-product-row.selected {
  background: var(--pm-primary-soft);
}

.pm-product-row.selected::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 50%;
  margin-top: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--pm-primary);
}

.pm-product-main {
  flex: 1;
  min-width: 0;
}

.pm-product-name-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.pm-product-no {
  font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
  color: var(--pm-ink-4);
  font-size: 22rpx;
}

.pm-product-name {
  color: var(--pm-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.pm-product-row.selected .pm-product-name {
  color: var(--pm-primary);
}

.pm-product-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.pm-product-price {
  flex-shrink: 0;
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--pm-ink);
}

/* ---------- №02 效果范例 ---------- */

.pm-example-subtitle {
  margin: 22rpx 0 24rpx;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.pm-example-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.pm-example-card {
  flex: 1;
  min-height: 240rpx;
  box-sizing: border-box;
  padding: 12rpx 12rpx 16rpx;
  background: var(--pm-card);
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  box-shadow: var(--pm-shadow-card);
  text-align: center;
}

.example-image {
  display: block;
  width: 100%;
  height: 300rpx;
  background: var(--pm-card-soft);
}

.pm-example-label {
  margin-top: 14rpx;
  color: var(--pm-ink-2);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.pm-example-arrow {
  flex-shrink: 0;
  color: var(--pm-ink-4);
  font-size: 34rpx;
  font-weight: 700;
}

.pm-example-title {
  margin-bottom: 18rpx;
  font-family: var(--pm-serif);
  color: var(--pm-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.pm-feature-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pm-feature-item {
  position: relative;
  padding-left: 28rpx;
  color: var(--pm-ink-2);
  font-size: 25rpx;
  line-height: 1.5;
}

.pm-feature-item::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 15rpx;
  width: 8rpx;
  height: 8rpx;
  background: var(--pm-primary);
}

/* ---------- №03 写真主题引言 ---------- */

.pm-theme-hint {
  padding: 22rpx 24rpx;
  background: var(--pm-card);
  border: 1rpx solid var(--pm-hairline);
  border-left: 4rpx solid var(--pm-primary);
  border-radius: var(--pm-radius);
  color: var(--pm-ink-2);
  font-size: 25rpx;
  line-height: 1.6;
}

/* ---------- №04/05 拍照引导：行式 ---------- */

.pm-guide-list {
  border-top: 1rpx solid var(--pm-hairline);
}

.pm-guide-item {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.pm-guide-no {
  flex-shrink: 0;
  font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
  color: var(--pm-primary);
  font-size: 24rpx;
}

.pm-guide-text {
  color: var(--pm-ink-2);
  font-size: 26rpx;
  line-height: 1.5;
}

/* ---------- №06 选择风格 ---------- */

.pm-style-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pm-style-chip {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-ink-2);
  font-size: 24rpx;
}

.pm-style-chip.selected {
  border-color: var(--pm-primary);
  background: var(--pm-primary);
  color: var(--pm-card);
}

.pm-style-code {
  font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--pm-ink-3);
}

.pm-style-chip.selected .pm-style-code {
  color: var(--pm-primary-line);
}

.pm-style-name {
  font-size: 26rpx;
  font-weight: 700;
}

/* ---------- №07 写真主题：小方签 + 拍立得样张 ---------- */

.pm-theme-list {
  display: flex;
  flex-direction: column;
}

.pm-theme-block {
  margin-bottom: 36rpx;
}

.pm-theme-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.pm-theme-chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
}

.pm-theme-chip.selected {
  border-color: var(--pm-primary);
  background: var(--pm-primary);
}

.pm-theme-name {
  color: var(--pm-ink);
  font-size: 26rpx;
  font-weight: 700;
}

.pm-theme-chip.selected .pm-theme-name {
  color: var(--pm-card);
}

.pm-theme-check {
  color: var(--pm-ink-3);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.pm-theme-chip.selected .pm-theme-check {
  color: var(--pm-card);
}

.pm-theme-desc {
  flex: 1;
  min-width: 0;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

/* 拍立得相纸样张 */
.pm-sample-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.pm-sample-row {
  display: inline-flex;
  align-items: flex-start;
  gap: 28rpx;
  padding: 12rpx 6rpx 24rpx;
}

.pm-polaroid {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  width: 240rpx;
  padding: 12rpx 12rpx 56rpx;
  box-sizing: border-box;
  background: var(--pm-card);
  border-radius: var(--pm-radius);
  box-shadow: var(--pm-shadow-card);
}

.pm-polaroid:nth-child(3n + 1) {
  transform: rotate(-1.5deg);
}

.pm-polaroid:nth-child(3n + 2) {
  transform: rotate(0.8deg);
}

.pm-polaroid:nth-child(3n) {
  transform: rotate(1.5deg);
}

.pm-polaroid-photo {
  display: block;
  width: 100%;
  height: 280rpx;
  background: var(--pm-card-soft);
}

.pm-polaroid-caption {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  color: var(--pm-ink-3);
  font-size: 20rpx;
  line-height: 1.4;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.pm-sample-empty {
  margin-top: 16rpx;
  padding: 24rpx;
  border: 1rpx dashed var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  color: var(--pm-ink-4);
  text-align: center;
  font-size: 24rpx;
}

/* 价格条：满幅白条 + 发丝上下边 */
.pm-price-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-top: 12rpx;
  padding: 26rpx 28rpx;
  background: var(--pm-card);
  border-top: 1rpx solid var(--pm-hairline-strong);
  border-bottom: 1rpx solid var(--pm-hairline-strong);
}

.pm-price-left {
  flex: 1;
  min-width: 0;
}

.pm-price-detail {
  color: var(--pm-ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.pm-price-count {
  margin-top: 8rpx;
  color: var(--pm-ink-3);
  font-size: 22rpx;
}

.pm-price-right {
  flex-shrink: 0;
  text-align: right;
}

.pm-price-total {
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--pm-ink);
}

.pm-price-photos {
  margin-top: 6rpx;
  color: var(--pm-ink-3);
  font-size: 22rpx;
}

.pm-price-hint {
  color: var(--pm-ink-4);
  font-size: 24rpx;
}

/* ---------- №08/09 表单 ---------- */

.pm-textarea {
  width: 100%;
  min-height: 170rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.pm-scene-input {
  margin-top: 24rpx;
}

.pm-input {
  width: 100%;
  height: 92rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-ink);
  font-size: 27rpx;
}

.pm-input:focus,
.pm-textarea:focus {
  border-bottom: 3rpx solid var(--pm-primary);
}

.pm-placeholder {
  color: var(--pm-ink-4);
}

.pm-form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
  font-size: 28rpx;
}

.pm-form-label {
  color: var(--pm-ink);
}

.pm-form-value {
  color: var(--pm-ink-2);
}

.pm-privacy-tip {
  margin-top: 16rpx;
  color: var(--pm-ink-4);
  font-size: 24rpx;
  line-height: 1.45;
}

/* 用途规格：右侧名称 + 毫米/像素小字（editorial 注脚式） */
.pm-spec-value {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  text-align: right;
}

.pm-spec-sub {
  color: var(--pm-ink-3);
  font-size: 22rpx;
  line-height: 1.4;
}

/* 底色：一行圆形色块直选（hex 由 wxml 内联 style 提供，此处仅形状与选中态） */
.pm-bg-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.pm-swatch-list {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-left: auto;
}

.pm-swatch {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: 50%;
}

.pm-swatch.selected {
  border: 3rpx solid var(--pm-primary);
  box-shadow: 0 0 0 6rpx var(--pm-primary-soft);
}

.pm-swatch-name {
  flex-shrink: 0;
  color: var(--pm-ink-2);
  font-size: 26rpx;
}

/* ---------- №10 上传正脸照 ---------- */

.pm-ai-btn {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--pm-primary-line);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-primary);
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.pm-ai-btn:active {
  background: var(--pm-primary-soft);
}

.pm-ai-btn.analyzing {
  opacity: 0.6;
}

.pm-upload-tip {
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.pm-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 22rpx;
}

.pm-photo-item,
.pm-photo-add {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius);
  background: var(--pm-card-soft);
}

.pm-photo-item image {
  display: block;
  width: 100%;
  height: 100%;
}

.pm-remove-photo {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--pm-radius);
  background: var(--pm-ink);
  opacity: 0.72;
  color: var(--pm-card);
  line-height: 40rpx;
  text-align: center;
  font-size: 30rpx;
}

.pm-photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 1rpx dashed var(--pm-hairline-strong);
  background: var(--pm-card);
  color: var(--pm-ink-3);
  font-size: 24rpx;
}

.pm-add-plus {
  font-size: 46rpx;
  line-height: 1;
  color: var(--pm-ink-4);
}

/* ---------- №11 AI 主题推荐 ---------- */

.pm-analysis-summary {
  margin-bottom: 26rpx;
  padding: 22rpx 24rpx;
  background: var(--pm-card);
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  color: var(--pm-ink-2);
  font-size: 25rpx;
  line-height: 1.55;
}

.pm-score-row {
  margin-bottom: 28rpx;
}

.pm-score-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.pm-score-name {
  color: var(--pm-ink);
  font-size: 27rpx;
  font-weight: 700;
}

.pm-recommend-badge {
  padding: 2rpx 10rpx;
  border-radius: var(--pm-radius);
  background: var(--pm-primary);
  color: var(--pm-card);
  font-size: 20rpx;
  font-weight: 700;
}

.pm-score-value {
  margin-left: auto;
  color: var(--pm-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.pm-score-track {
  height: 2rpx;
  background: var(--pm-hairline-strong);
}

.pm-score-fill {
  height: 2rpx;
  background: var(--pm-primary);
}

.pm-score-reason {
  margin-top: 12rpx;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ---------- 通用按钮（白底蓝字发丝边直角） ---------- */

.pm-btn-ghost {
  margin-top: 12rpx;
  width: 100%;
  padding: 18rpx 0;
  box-sizing: border-box;
  border: 1rpx solid var(--pm-primary-line);
  border-radius: var(--pm-radius);
  background: var(--pm-card);
  color: var(--pm-primary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.pm-btn-ghost::after {
  border: none;
}

.pm-btn-ghost:active {
  background: var(--pm-primary-soft);
}

.pm-apply-btn {
  margin-top: 4rpx;
}

/* ---------- №12 授权确认（方形勾选，选中蓝） ---------- */

.pm-auth-list {
  margin-bottom: 14rpx;
}

.pm-auth-text {
  margin-bottom: 10rpx;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.55;
}

.pm-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
  color: var(--pm-ink);
  font-size: 27rpx;
}

.pm-switch-row:last-of-type {
  border-bottom: none;
}

.pm-switch-row switch.wx-switch .wx-switch-input,
.pm-switch-row switch .wx-switch-input {
  border-radius: var(--pm-radius);
}

.pm-switch-row switch .wx-switch-input.wx-switch-input-checked {
  background-color: var(--pm-primary);
  border-color: var(--pm-primary);
}

/* ---------- 主提交按钮 ---------- */

.pm-submit-btn {
  margin: 56rpx 0 8rpx;
  width: 100%;
  padding: 26rpx 0;
  box-sizing: border-box;
  border-radius: var(--pm-radius);
  background: var(--pm-primary);
  color: var(--pm-card);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.pm-submit-btn::after {
  border: none;
}

.pm-submit-btn:active {
  background: linear-gradient(180deg, var(--pm-primary), var(--pm-primary-deep));
}

.pm-submit-btn[disabled] {
  background: var(--pm-ink-4);
  color: var(--pm-card);
}

/* ---------- №13 查询订单 ---------- */

.pm-query-section {
  margin-top: 56rpx;
}

.pm-query-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.pm-query-head-main {
  flex: 1;
  min-width: 0;
}

.pm-query-desc {
  margin-top: 16rpx;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.pm-query-toggle {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--pm-primary-line);
  border-radius: var(--pm-radius);
  color: var(--pm-primary);
  font-size: 22rpx;
}

.pm-query-form {
  margin-top: 24rpx;
}

/* ---------- №14 我的订单：纸面卡 ---------- */

.pm-orders-section {
  margin-top: 56rpx;
}

.pm-empty-state {
  padding: 48rpx 0;
  color: var(--pm-ink-4);
  text-align: center;
  font-size: 26rpx;
}

.pm-order-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  background: var(--pm-card);
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  box-shadow: var(--pm-shadow-card);
}

.pm-order-main {
  flex: 1;
  min-width: 0;
}

.pm-order-title {
  color: var(--pm-ink);
  font-size: 29rpx;
  font-weight: 700;
}

.pm-order-id {
  margin-top: 6rpx;
  font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
  color: var(--pm-ink-3);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.pm-order-meta {
  margin-top: 8rpx;
  color: var(--pm-ink-3);
  font-size: 24rpx;
  line-height: 1.4;
}

.pm-order-note {
  margin-top: 8rpx;
  color: var(--pm-warning);
  font-size: 23rpx;
  line-height: 1.4;
}

/* 状态方签：1px 边 + 状态色字 + soft 底，直角 4rpx */
.pm-order-status {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--pm-primary-line);
  border-radius: 4rpx;
  background: var(--pm-primary-soft);
  color: var(--pm-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.pm-order-status.st-delivered,
.pm-order-status.st-completed,
.pm-order-status.st-closed {
  border-color: var(--pm-success);
  background: var(--pm-success-soft);
  color: var(--pm-success);
}

.pm-order-status.st-revision,
.pm-order-status.st-cancelled {
  border-color: var(--pm-danger);
  background: var(--pm-danger-soft);
  color: var(--pm-danger);
}

.pm-order-status.st-waiting_photos,
.pm-order-status.st-waiting_authorization {
  border-color: var(--pm-warning);
  background: var(--pm-warning-soft);
  color: var(--pm-warning);
}

/* ---------- 管理入口：小字链接式 ---------- */

.pm-admin-entry {
  margin: 24rpx 0 40rpx;
  color: var(--pm-ink-4);
  text-align: center;
  font-size: 24rpx;
  text-decoration: underline;
}

/* 查询按钮修饰：与主按钮留出一行间距，宽度自适应 */
.pm-query-btn {
  margin-top: 24rpx;
  width: auto;
  padding: 16rpx 56rpx;
}
