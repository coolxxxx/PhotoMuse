<view class="admin-page">
  <view class="page-nav">
    <view class="nav-back" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">订单管理</view>
    <view class="nav-exit" bindtap="logoutAdmin">退出</view>
  </view>

  <view class="header">
    <view class="header-main">
      <view class="header-eyebrow">OPERATIONS — PhotoMuse</view>
      <view class="header-title">订单管理</view>
      <view class="header-desc">仅白名单运营 openid 可审核、拒单和交付。</view>
    </view>
    <view class="header-actions">
      <button size="mini" class="action-btn payment-qr" loading="{{actionOrderId === 'payment-qr'}}" bindtap="setupPaymentQR">收款设置</button>
      <button size="mini" class="action-btn model-btn {{showModelPanel ? 'active' : ''}}" bindtap="toggleModelPanel">模型设置</button>
      <button size="mini" class="action-btn samples-btn {{showSamplesPanel ? 'active' : ''}}" bindtap="toggleSamplesPanel">样张管理</button>
      <button size="mini" class="action-btn pricing-btn {{showPricingPanel ? 'active' : ''}}" bindtap="togglePricingPanel">定价设置</button>
    </view>
  </view>

  <view wx:if="{{showModelPanel}}" class="model-panel">
    <view class="panel-title">模型设置</view>
    <view class="panel-section">
      <view class="section-title">证件照引擎（HivisionIDPhotos）</view>
      <view class="form-row switch-row">
        <view class="form-label">启用引擎</view>
        <switch checked="{{idphotoConfig.enabled}}" color="#1976D2" bindchange="onIdphotoEnabledChange" />
      </view>
      <view class="form-row">
        <view class="form-label">接口地址</view>
        <input class="form-input" value="{{idphotoConfig.apiUrl}}" placeholder="http://服务器IP:8080，部署见 docs/部署指南.md" placeholder-class="input-placeholder" data-field="apiUrl" bindinput="onIdphotoFieldInput" />
      </view>
      <view class="form-row switch-row">
        <view class="form-label">人脸对齐</view>
        <switch checked="{{idphotoConfig.faceAlignment}}" color="#1976D2" bindchange="onIdphotoFaceAlignChange" />
      </view>
    </view>
    <view class="panel-section">
      <view class="section-title">AI 生图接口（写真）</view>
      <view class="form-row">
        <view class="form-label">接口地址</view>
        <input class="form-input" value="{{modelConfig.apiUrl}}" placeholder="https://open.bigmodel.cn/api/paas/v4/images/generations" placeholder-class="input-placeholder" data-field="apiUrl" bindinput="onModelFieldInput" />
      </view>
      <view class="form-row">
        <view class="form-label">API Key</view>
        <input class="form-input" password value="{{modelConfig.apiKey}}" placeholder="留空则不修改已保存的 Key" placeholder-class="input-placeholder" data-field="apiKey" bindinput="onModelFieldInput" />
      </view>
      <view class="form-row">
        <view class="form-label">模型名称</view>
        <input class="form-input" value="{{modelConfig.model}}" placeholder="cogview-4" placeholder-class="input-placeholder" data-field="model" bindinput="onModelFieldInput" />
      </view>
      <view class="form-row">
        <view class="form-label">图片尺寸</view>
        <picker class="form-picker" mode="selector" range="{{imageSizeOptions}}" value="{{imageSizeIndex}}" bindchange="onImageSizeChange">
          <view class="picker-value">{{modelConfig.imageSize}}</view>
        </picker>
      </view>
      <view class="form-row switch-row">
        <view class="form-label">启用生图接口</view>
        <switch checked="{{modelConfig.enabled}}" color="#1976D2" bindchange="onModelEnabledChange" />
      </view>
    </view>
    <view class="panel-footer">
      <button size="mini" class="action-btn save-model" loading="{{isSavingModel}}" bindtap="saveModelSettings">保存设置</button>
    </view>
  </view>

  <view wx:if="{{showSamplesPanel}}" class="model-panel">
    <view class="panel-title">样张管理</view>
    <view class="sample-toolbar">
      <button size="mini" class="action-btn sample-upload" bindtap="uploadSample">上传样张</button>
      <button size="mini" class="action-btn sample-generate" loading="{{actionOrderId === 'gen-sample'}}" bindtap="generateSample">AI 生成样张</button>
      <button size="mini" class="action-btn sample-register" bindtap="registerSampleFromFile">从文件登记</button>
      <button size="mini" class="action-btn sample-refresh" loading="{{isLoadingSamples}}" bindtap="loadSamples">刷新</button>
    </view>
    <view class="sample-hint">「AI 生成样张」的成片先挂在所选订单名下（fileType=sample），生成后复制其 fileID，用「从文件登记」登入样张库。</view>
    <view wx:if="{{isLoadingSamples}}" class="sample-empty">样张加载中...</view>
    <view wx:for="{{sampleGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="themeId" class="sample-group">
      <view class="sample-group-title">{{group.themeName}}</view>
      <view wx:if="{{group.items.length === 0}}" class="sample-empty">暂无样张</view>
      <view wx:for="{{group.items}}" wx:for-item="sample" wx:for-index="itemIndex" wx:key="sampleId" class="sample-item">
        <image
          class="sample-thumb"
          src="{{sample.tempUrl}}"
          mode="aspectFill"
          data-url="{{sample.tempUrl}}"
          data-urls="{{[sample.tempUrl]}}"
          bindtap="previewImage"
        ></image>
        <view class="sample-fields">
          <input
            class="sample-input caption"
            value="{{sample.caption}}"
            placeholder="样张说明 caption"
            placeholder-class="input-placeholder"
            data-group-index="{{groupIndex}}"
            data-item-index="{{itemIndex}}"
            data-field="caption"
            bindinput="onSampleFieldInput"
          />
          <view class="sample-meta-row">
            <text class="sample-sort-label">排序</text>
            <input
              class="sample-input sort"
              type="number"
              value="{{sample.sortOrder}}"
              data-group-index="{{groupIndex}}"
              data-item-index="{{itemIndex}}"
              data-field="sortOrder"
              bindinput="onSampleFieldInput"
            />
            <switch
              class="sample-switch"
              checked="{{sample.enabled}}"
              color="#2E6B3F"
              data-group-index="{{groupIndex}}"
              data-item-index="{{itemIndex}}"
              bindchange="onSampleEnabledChange"
            />
            <button size="mini" class="action-btn sample-save" data-group-index="{{groupIndex}}" data-item-index="{{itemIndex}}" bindtap="saveSampleItem">保存</button>
            <button size="mini" class="action-btn sample-remove" data-group-index="{{groupIndex}}" data-item-index="{{itemIndex}}" bindtap="removeSample">删除</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showPricingPanel}}" class="model-panel">
    <view class="panel-title">写真定价设置</view>
    <view class="form-row">
      <view class="form-label">基础主题价</view>
      <input class="form-input" type="digit" value="{{pricingConfig.baseThemePrice}}" placeholder="69.9" placeholder-class="input-placeholder" data-field="baseThemePrice" bindinput="onPricingFieldInput" />
    </view>
    <view class="form-row">
      <view class="form-label">加一主题加价</view>
      <input class="form-input" type="digit" value="{{pricingConfig.extraThemePrice}}" placeholder="39.9" placeholder-class="input-placeholder" data-field="extraThemePrice" bindinput="onPricingFieldInput" />
    </view>
    <view class="form-row">
      <view class="form-label">最多主题数</view>
      <input class="form-input" type="number" value="{{pricingConfig.maxThemes}}" placeholder="1-5 的整数" placeholder-class="input-placeholder" data-field="maxThemes" bindinput="onPricingFieldInput" />
    </view>
    <view class="form-row">
      <view class="form-label">每主题成片数</view>
      <input class="form-input" type="number" value="{{pricingConfig.photosPerTheme}}" placeholder="1-15 的整数" placeholder-class="input-placeholder" data-field="photosPerTheme" bindinput="onPricingFieldInput" />
    </view>
    <view class="panel-footer">
      <button size="mini" class="action-btn save-pricing" loading="{{isSavingPricing}}" bindtap="savePricingConfig">保存定价</button>
    </view>
  </view>

  <scroll-view scroll-x class="status-tabs">
    <view
      wx:for="{{statusOptions}}"
      wx:key="value"
      class="status-tab {{selectedStatus === item.value ? 'active' : ''}}"
      data-status="{{item.value}}"
      bindtap="selectStatus"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view wx:if="{{orders.length === 0}}" class="empty-state">
    {{isLoading ? '加载中...' : '当前状态下暂无订单'}}
  </view>

  <view wx:for="{{orders}}" wx:key="orderId" class="order-card">
    <view class="order-head">
      <view>
        <view class="order-title">{{item.productName}}</view>
        <view class="order-meta">{{item.orderId}}</view>
      </view>
      <view class="status-badge st-{{item.order_status}}">{{item.statusText}}</view>
    </view>

    <view class="order-info">
      <text wx:if="{{item.product_type === 'portrait' && item.theme_name}}">{{item.theme_name}}</text>
      <text>{{item.styleName}}</text>
      <text>{{item.photoCheckText}}</text>
      <text>{{item.reference_photo_count || 0}} 张参考图</text>
      <text wx:if="{{item.payment_status === 'unpaid'}}" class="pay-tag unpaid">未支付</text>
      <text wx:elif="{{item.payment_status === 'paid'}}" class="pay-tag paid-tag" title="{{item.paidNote || ''}}">已支付</text>
    </view>

    <view wx:if="{{item.reviewNote}}" class="review-note">{{item.reviewNote}}</view>

    <view class="image-row" wx:if="{{item.customerFiles.length}}">
      <image
        wx:for="{{item.customerFiles}}"
        wx:key="fileId"
        src="{{item.tempUrl}}"
        mode="aspectFill"
        data-url="{{item.tempUrl}}"
        data-urls="{{item.customerUrls}}"
        bindtap="previewImage"
      ></image>
    </view>

    <view class="image-row gen-row" wx:if="{{item.generatedFiles.length || item.printTicketFiles.length}}">
      <image
        wx:for="{{item.generatedFiles}}"
        wx:for-item="genFile"
        wx:key="fileId"
        class="gen-thumb"
        src="{{genFile.tempUrl}}"
        mode="aspectFill"
        data-url="{{genFile.tempUrl}}"
        data-urls="{{item.generatedUrls}}"
        bindtap="previewImage"
      ></image>
      <view
        wx:for="{{item.printTicketFiles}}"
        wx:for-item="ticket"
        wx:key="fileId"
        class="ticket-chip"
      >制作单</view>
    </view>

    <view wx:if="{{item.merchItems.length}}" class="merch-list">
      <view class="merch-title">周边清单</view>
      <view wx:for="{{item.merchItems}}" wx:for-item="merch" wx:key="merchItemId" class="merch-line">
        <text class="merch-name">{{merch.name}}×{{merch.qty}}</text>
        <text class="merch-price">¥{{merch.lineTotal}}</text>
      </view>
      <view class="merch-line merch-sum">
        <text>周边合计</text>
        <text class="merch-price">¥{{item.merchTotal}}</text>
      </view>
    </view>

    <view class="actions">
      <button size="mini" class="action-btn pass" data-id="{{item.orderId}}" loading="{{actionOrderId === item.orderId}}" bindtap="passReview">通过</button>
      <button size="mini" class="action-btn retake" data-id="{{item.orderId}}" loading="{{actionOrderId === item.orderId}}" bindtap="requestRetake">重拍</button>
      <button size="mini" class="action-btn reject" data-id="{{item.orderId}}" loading="{{actionOrderId === item.orderId}}" bindtap="rejectOrder">拒单</button>
      <button wx:if="{{item.payment_status === 'unpaid'}}" size="mini" class="action-btn paid" data-id="{{item.orderId}}" loading="{{actionOrderId === item.orderId}}" bindtap="markOrderPaid">标记已付</button>
      <button wx:if="{{item.product_type === 'portrait' && (item.order_status === 'queued' || item.order_status === 'grid_preview' || item.order_status === 'cell_selected')}}" size="mini" class="action-btn grid" data-id="{{item.orderId}}" loading="{{actionOrderId === item.orderId}}" bindtap="chooseGridPreview">上传网格</button>
      <button wx:if="{{item.order_status === 'queued' || item.order_status === 'grid_preview' || item.order_status === 'cell_selected'}}" size="mini" class="action-btn gen-ref" data-id="{{item.orderId}}" loading="{{actionOrderId === 'gen:' + item.orderId}}" bindtap="generateReferenceImage">生成参考图</button>
      <button wx:if="{{item.product_type !== 'portrait' && (item.order_status === 'queued' || item.order_status === 'grid_preview' || item.order_status === 'cell_selected' || item.order_status === 'generating' || item.order_status === 'qc')}}" size="mini" class="action-btn idphoto" data-id="{{item.orderId}}" loading="{{actionOrderId === 'gen:' + item.orderId}}" bindtap="generateIdphotoImage">AI 证件照</button>
      <button wx:if="{{item.product_type === 'portrait' && (item.order_status === 'queued' || item.order_status === 'grid_preview' || item.order_status === 'cell_selected')}}" size="mini" class="action-btn gen-grid" data-id="{{item.orderId}}" loading="{{actionOrderId === 'gen:' + item.orderId}}" bindtap="generateGridImage">生成网格</button>
      <button wx:if="{{item.product_type === 'portrait' && item.order_status === 'cell_selected' && item.hasSelectedCells}}" size="mini" class="action-btn gen-cell" data-id="{{item.orderId}}" loading="{{actionOrderId === 'gen:' + item.orderId}}" bindtap="generateCellImage">生成分镜图</button>
      <button size="mini" class="action-btn deliver" data-id="{{item.orderId}}" loading="{{actionOrderId === item.orderId}}" bindtap="chooseDelivery">上传交付</button>
      <button wx:if="{{item.merchItems.length}}" size="mini" class="action-btn merch-export" data-id="{{item.orderId}}" loading="{{actionOrderId === 'export:' + item.orderId}}" bindtap="exportPrintFiles">导出制作稿</button>
      <button wx:if="{{item.order_status === 'merch_pending'}}" size="mini" class="action-btn merch-start" data-id="{{item.orderId}}" loading="{{actionOrderId === item.orderId}}" bindtap="startMerchProduction">开始制作</button>
      <button wx:if="{{item.order_status === 'in_production'}}" size="mini" class="action-btn merch-ship" data-id="{{item.orderId}}" loading="{{actionOrderId === item.orderId}}" bindtap="shipMerchProduction">发货完成</button>
    </view>
  </view>
</view>
