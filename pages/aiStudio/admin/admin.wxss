.admin-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f9ff;
}

.page-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.nav-back,
.nav-exit {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1976d2;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(25, 118, 210, 0.08);
}

.nav-title {
  flex: 1;
  color: #1f2d3d;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}

.nav-exit {
  color: #e65100;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(25, 118, 210, 0.08);
}

.header-main {
  flex: 1;
  min-width: 0;
}

.header-actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.payment-qr {
  flex-shrink: 0;
  color: #1976d2;
  background: #ffffff;
  border: 2rpx solid #1976d2;
}

.model-btn {
  flex-shrink: 0;
  color: #6a1b9a;
  background: #ffffff;
  border: 2rpx solid #6a1b9a;
}

.model-btn.active {
  color: #ffffff;
  background: #6a1b9a;
}

.model-panel {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(25, 118, 210, 0.08);
}

.panel-title {
  margin-bottom: 20rpx;
  color: #1f2d3d;
  font-size: 30rpx;
  font-weight: 800;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.form-label {
  flex-shrink: 0;
  width: 150rpx;
  color: #455a64;
  font-size: 25rpx;
  font-weight: 600;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f2f6fa;
  color: #263238;
  font-size: 25rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #9fb3c8;
  font-size: 23rpx;
}

.form-picker {
  flex: 1;
  min-width: 0;
}

.picker-value {
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f2f6fa;
  color: #263238;
  font-size: 25rpx;
  line-height: 68rpx;
  box-sizing: border-box;
}

.switch-row {
  justify-content: space-between;
}

.switch-row .form-label {
  width: auto;
}

.panel-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 6rpx;
}

.save-model {
  color: #ffffff;
  background: #6a1b9a;
}

.header-title {
  margin-bottom: 10rpx;
  color: #1f2d3d;
  font-size: 36rpx;
  font-weight: 800;
}

.header-desc {
  color: #607d8b;
  font-size: 25rpx;
  line-height: 1.45;
}

.status-tabs {
  margin: 22rpx 0;
  white-space: nowrap;
}

.status-tab {
  display: inline-block;
  margin-right: 14rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #607d8b;
  font-size: 26rpx;
}

.status-tab.active {
  background: #1976d2;
  color: #ffffff;
}

.order-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(25, 118, 210, 0.08);
}

.order-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.order-title {
  margin-bottom: 8rpx;
  color: #263238;
  font-size: 30rpx;
  font-weight: 700;
}

.order-meta,
.order-info,
.review-note,
.empty-state {
  color: #607d8b;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-pill {
  flex-shrink: 0;
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 24rpx;
  font-weight: 600;
}

.order-info {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
}

.pay-tag {
  align-self: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.pay-tag.unpaid {
  color: #f57c00;
  background: #fff3e0;
}

.pay-tag.paid-tag {
  color: #2e7d32;
  background: #e8f5e9;
}

.review-note {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  color: #e65100;
  background: #fff7ed;
}

.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.image-row image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #eef3f8;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.action-btn {
  margin: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.pass {
  color: #ffffff;
  background: #2e7d32;
}

.retake {
  color: #ffffff;
  background: #f57c00;
}

.reject {
  color: #ffffff;
  background: #c62828;
}

.deliver {
  color: #ffffff;
  background: #1976d2;
}

.paid {
  color: #ffffff;
  background: #1565c0;
}

.grid {
  color: #ffffff;
  background: #1976d2;
}

.gen-ref {
  color: #ffffff;
  background: #7b1fa2;
}

.gen-grid {
  color: #ffffff;
  background: #5e35b1;
}

.gen-cell {
  color: #ffffff;
  background: #00897b;
}

.gen-row {
  padding-top: 6rpx;
  border-top: 2rpx dashed #e3f2fd;
}

.gen-thumb {
  border: 2rpx solid #e1bee7;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
}

/* ---------------- 样张管理 / 定价设置 ---------------- */
.samples-btn {
  flex-shrink: 0;
  color: #2e7d32;
  background: #ffffff;
  border: 2rpx solid #2e7d32;
}

.samples-btn.active {
  color: #ffffff;
  background: #2e7d32;
}

.pricing-btn {
  flex-shrink: 0;
  color: #e65100;
  background: #ffffff;
  border: 2rpx solid #e65100;
}

.pricing-btn.active {
  color: #ffffff;
  background: #e65100;
}

.save-pricing {
  color: #ffffff;
  background: #e65100;
}

.sample-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.sample-upload {
  color: #ffffff;
  background: #2e7d32;
}

.sample-generate {
  color: #ffffff;
  background: #7b1fa2;
}

.sample-register {
  color: #1565c0;
  background: #ffffff;
  border: 2rpx solid #1565c0;
}

.sample-refresh {
  color: #455a64;
  background: #ffffff;
  border: 2rpx solid #90a4ae;
}

.sample-hint {
  margin-bottom: 14rpx;
  color: #90a4ae;
  font-size: 22rpx;
  line-height: 1.5;
}

.sample-group {
  margin-bottom: 16rpx;
}

.sample-group-title {
  margin-bottom: 8rpx;
  color: #1976d2;
  font-size: 26rpx;
  font-weight: 700;
}

.sample-empty {
  padding: 14rpx 0;
  color: #90a4ae;
  font-size: 24rpx;
}

.sample-item {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 2rpx dashed #eef3f8;
}

.sample-thumb {
  flex-shrink: 0;
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #eef3f8;
}

.sample-fields {
  flex: 1;
  min-width: 0;
}

.sample-input {
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f2f6fa;
  color: #263238;
  font-size: 24rpx;
  box-sizing: border-box;
}

.sample-input.caption {
  width: 100%;
  margin-bottom: 10rpx;
}

.sample-input.sort {
  width: 96rpx;
  text-align: center;
}

.sample-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sample-sort-label {
  flex-shrink: 0;
  color: #455a64;
  font-size: 23rpx;
}

.sample-switch {
  flex-shrink: 0;
  margin: 0 -6rpx;
  transform: scale(0.7);
}

.sample-save {
  color: #ffffff;
  background: #1976d2;
}

.sample-remove {
  color: #c62828;
  background: #ffffff;
  border: 2rpx solid #c62828;
}

/* ---------------- 周边清单 / 制作流转 ---------------- */
.merch-list {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  border: 2rpx solid #e3f2fd;
}

.merch-title {
  margin-bottom: 10rpx;
  color: #1565c0;
  font-size: 26rpx;
  font-weight: 700;
}

.merch-line {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0;
  color: #37474f;
  font-size: 24rpx;
  line-height: 1.5;
}

.merch-name {
  flex: 1;
  min-width: 0;
}

.merch-price {
  flex-shrink: 0;
  color: #1565c0;
  font-weight: 600;
}

.merch-sum {
  margin-top: 6rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed #bbdefb;
  color: #0d47a1;
  font-weight: 700;
}

.merch-export {
  color: #ffffff;
  background: #00695c;
}

.merch-start {
  color: #ffffff;
  background: #ef6c00;
}

.merch-ship {
  color: #ffffff;
  background: #2e7d32;
}

.ticket-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #e0f2f1;
  border: 2rpx dashed #00695c;
  color: #00695c;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}
