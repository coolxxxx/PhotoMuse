.admin-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f9ff;
}

.page-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.nav-back,
.nav-exit {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1976d2;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(25, 118, 210, 0.08);
}

.nav-title {
  flex: 1;
  color: #1f2d3d;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}

.nav-exit {
  color: #e65100;
}

.header {
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(25, 118, 210, 0.08);
}

.header-title {
  margin-bottom: 10rpx;
  color: #1f2d3d;
  font-size: 36rpx;
  font-weight: 800;
}

.header-desc {
  color: #607d8b;
  font-size: 25rpx;
  line-height: 1.45;
}

.status-tabs {
  margin: 22rpx 0;
  white-space: nowrap;
}

.status-tab {
  display: inline-block;
  margin-right: 14rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #607d8b;
  font-size: 26rpx;
}

.status-tab.active {
  background: #1976d2;
  color: #ffffff;
}

.order-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(25, 118, 210, 0.08);
}

.order-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.order-title {
  margin-bottom: 8rpx;
  color: #263238;
  font-size: 30rpx;
  font-weight: 700;
}

.order-meta,
.order-info,
.review-note,
.empty-state {
  color: #607d8b;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-pill {
  flex-shrink: 0;
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 24rpx;
  font-weight: 600;
}

.order-info {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
}

.review-note {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  color: #e65100;
  background: #fff7ed;
}

.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.image-row image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #eef3f8;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.action-btn {
  margin: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.pass {
  color: #ffffff;
  background: #2e7d32;
}

.retake {
  color: #ffffff;
  background: #f57c00;
}

.reject {
  color: #ffffff;
  background: #c62828;
}

.deliver {
  color: #ffffff;
  background: #1976d2;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
}
