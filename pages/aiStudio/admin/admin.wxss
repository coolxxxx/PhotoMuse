/* ============================================================
   订单管理 · Editorial 纸面风
   设计令牌以页面级变量定义（值与全局规范一致），全部颜色经 var() 引用
   ============================================================ */


.admin-page button::after {
  border: none;
}

/* ---------------- 顶部导航 ---------------- */
.page-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.nav-back,
.nav-exit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: 0;
  background: var(--pm-card);
  color: var(--pm-primary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nav-exit {
  color: var(--pm-danger);
}

.nav-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--pm-ink-3);
  font-family: var(--pm-serif);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------------- 纸面页眉 ---------------- */
.header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

.header-main {
  flex: 1;
  min-width: 0;
}

.header-eyebrow {
  margin-bottom: 10rpx;
  color: var(--pm-primary);
  font-family: var(--pm-mono);
  font-size: 20rpx;
  letter-spacing: 5rpx;
}

.header-title {
  margin-bottom: 12rpx;
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.15;
}

.header-desc {
  color: var(--pm-ink-2);
  font-size: 24rpx;
  line-height: 1.55;
}

.header-actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

/* ---------------- 小方签按钮基类 ---------------- */
.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 20rpx;
  min-height: 52rpx;
  border-radius: 0;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1;
}

/* 页眉四设置键：白底蓝字发丝边直角，active 蓝底白字 */
.payment-qr,
.model-btn,
.samples-btn,
.pricing-btn {
  background: var(--pm-card);
  color: var(--pm-primary);
  border: 1rpx solid var(--pm-hairline-strong);
}

.model-btn.active,
.samples-btn.active,
.pricing-btn.active {
  background: var(--pm-primary);
  color: var(--pm-card);
  border-color: var(--pm-primary);
}

/* ---------------- 设置面板：纸面卡 + 行式表单 ---------------- */
.model-panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

.panel-title {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.form-label {
  flex-shrink: 0;
  width: 170rpx;
  color: var(--pm-ink-2);
  font-family: var(--pm-mono);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.form-input,
.picker-value {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: 0;
  background: var(--pm-card);
  color: var(--pm-ink);
  font-size: 25rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--pm-primary);
}

.input-placeholder {
  color: var(--pm-ink-3);
  font-size: 23rpx;
}

.form-picker {
  flex: 1;
  min-width: 0;
}

.picker-value {
  display: block;
  line-height: 66rpx;
}

.switch-row {
  justify-content: space-between;
}

.switch-row .form-label {
  width: auto;
}

.panel-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.save-model,
.save-pricing {
  background: var(--pm-primary);
  color: var(--pm-card);
  border: 1rpx solid var(--pm-primary);
}

/* ---------------- 状态 tabs：下划线式 ---------------- */
.status-tabs {
  margin: 28rpx 0 24rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
  white-space: nowrap;
}

.status-tab {
  display: inline-block;
  margin-right: 30rpx;
  padding: 10rpx 6rpx 16rpx;
  border-bottom: 4rpx solid transparent;
  color: var(--pm-ink-3);
  font-size: 26rpx;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.status-tab.active {
  border-bottom-color: var(--pm-primary);
  color: var(--pm-primary);
  font-weight: 700;
}

/* ---------------- 订单卡：发丝边白卡直角 ---------------- */
.order-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  background: var(--pm-card);
  box-shadow: var(--pm-shadow-card);
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.order-title {
  margin-bottom: 8rpx;
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.order-meta {
  color: var(--pm-ink-3);
  font-family: var(--pm-mono);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* 状态徽章：方签，默认（审核/制作/周边类）primary */
.status-badge {
  flex-shrink: 0;
  align-self: flex-start;
  padding: 6rpx 12rpx;
  border-radius: 0;
  background: var(--pm-primary-soft);
  color: var(--pm-primary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 交付 / 完结类 = success */
.st-delivered,
.st-closed,
.st-completed {
  background: var(--pm-success-soft);
  color: var(--pm-success);
}

/* 重拍 / 待补图类 = warning */
.st-waiting_photos,
.st-revision {
  background: var(--pm-warning-soft);
  color: var(--pm-warning);
}

/* 取消类 = danger */
.st-cancelled {
  background: var(--pm-danger-soft);
  color: var(--pm-danger);
}

.order-info {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 22rpx;
  color: var(--pm-ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.pay-tag {
  align-self: center;
  padding: 4rpx 10rpx;
  border-radius: 0;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.pay-tag.unpaid {
  background: var(--pm-warning-soft);
  color: var(--pm-warning);
}

.pay-tag.paid-tag {
  background: var(--pm-success-soft);
  color: var(--pm-success);
}

.review-note {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid var(--pm-warning);
  background: var(--pm-card-soft);
  color: var(--pm-ink-2);
  font-size: 24rpx;
  line-height: 1.55;
}

/* 图片行：缩略发丝边直角 */
.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.image-row image {
  width: 150rpx;
  height: 150rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 0;
  background: var(--pm-card-soft);
}

.gen-row {
  padding-top: 18rpx;
  border-top: 1rpx solid var(--pm-hairline);
}

.gen-thumb {
  border: 1rpx solid var(--pm-primary-line);
}

.ticket-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border: 1rpx dashed var(--pm-primary-line);
  border-radius: 0;
  background: var(--pm-primary-soft);
  color: var(--pm-primary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

/* ---------------- 周边清单：行式 + 衬线斜体合计 ---------------- */
.merch-list {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 0;
  background: var(--pm-card-soft);
}

.merch-title {
  margin-bottom: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--pm-hairline-strong);
  color: var(--pm-ink-2);
  font-family: var(--pm-mono);
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.merch-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--pm-hairline);
  color: var(--pm-ink-2);
  font-size: 24rpx;
  line-height: 1.55;
}

.merch-name {
  flex: 1;
  min-width: 0;
}

.merch-price {
  flex-shrink: 0;
  color: var(--pm-ink);
  font-family: var(--pm-mono);
  font-size: 24rpx;
}

.merch-sum {
  margin-top: 6rpx;
  padding: 12rpx 0 4rpx;
  border-top: 1rpx solid var(--pm-hairline-strong);
  border-bottom: none;
  color: var(--pm-ink);
  font-family: var(--pm-serif);
  font-size: 28rpx;
}

.merch-sum .merch-price {
  font-family: var(--pm-serif);
  font-style: italic;
  font-size: 28rpx;
}

/* ---------------- 操作按钮：直角小方签系 ---------------- */
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--pm-hairline);
}

/* 实底系 */
.pass {
  background: var(--pm-success);
  color: var(--pm-card);
  border: 1rpx solid var(--pm-success);
}

.retake {
  background: var(--pm-warning);
  color: var(--pm-card);
  border: 1rpx solid var(--pm-warning);
}

.reject {
  background: var(--pm-danger);
  color: var(--pm-card);
  border: 1rpx solid var(--pm-danger);
}

.deliver {
  background: var(--pm-primary);
  color: var(--pm-card);
  border: 1rpx solid var(--pm-primary);
}

/* 白底描边系（对应色字） */
.paid {
  background: var(--pm-card);
  color: var(--pm-success);
  border: 1rpx solid var(--pm-success);
}

.grid {
  background: var(--pm-card);
  color: var(--pm-primary);
  border: 1rpx solid var(--pm-primary);
}

.merch-export {
  background: var(--pm-card);
  color: var(--pm-primary);
  border: 1rpx solid var(--pm-primary);
}

.merch-start {
  background: var(--pm-card);
  color: var(--pm-warning);
  border: 1rpx solid var(--pm-warning);
}

.merch-ship {
  background: var(--pm-card);
  color: var(--pm-success);
  border: 1rpx solid var(--pm-success);
}

/* AI 类：统一中性 */
.gen-ref,
.gen-grid,
.gen-cell {
  background: var(--pm-card);
  color: var(--pm-ink-2);
  border: 1rpx solid var(--pm-hairline-strong);
}

/* ---------------- 空态 / 加载：纸面 + 衬线 ---------------- */
.empty-state {
  padding: 90rpx 0;
  border: 1rpx solid var(--pm-hairline);
  border-radius: var(--pm-radius-card);
  background: var(--pm-card);
  color: var(--pm-ink-3);
  font-family: var(--pm-serif);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

/* ---------------- 样张管理 ---------------- */
.sample-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.sample-upload {
  background: var(--pm-primary);
  color: var(--pm-card);
  border: 1rpx solid var(--pm-primary);
}

.sample-generate {
  background: var(--pm-card);
  color: var(--pm-ink-2);
  border: 1rpx solid var(--pm-hairline-strong);
}

.sample-register {
  background: var(--pm-card);
  color: var(--pm-primary);
  border: 1rpx solid var(--pm-primary);
}

.sample-refresh {
  background: var(--pm-card);
  color: var(--pm-ink-2);
  border: 1rpx solid var(--pm-hairline-strong);
}

.sample-hint {
  margin-bottom: 16rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid var(--pm-primary-line);
  background: var(--pm-card-soft);
  color: var(--pm-ink-3);
  font-size: 22rpx;
  line-height: 1.55;
}

.sample-group {
  margin-bottom: 18rpx;
}

.sample-group-title {
  margin-bottom: 6rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--pm-hairline);
  color: var(--pm-ink-2);
  font-family: var(--pm-mono);
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.sample-empty {
  padding: 16rpx 0;
  color: var(--pm-ink-3);
  font-family: var(--pm-serif);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.sample-item {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--pm-hairline);
}

.sample-thumb {
  flex-shrink: 0;
  width: 110rpx;
  height: 110rpx;
  border: 1rpx solid var(--pm-hairline);
  border-radius: 0;
  background: var(--pm-card-soft);
}

.sample-fields {
  flex: 1;
  min-width: 0;
}

.sample-input {
  height: 56rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--pm-hairline-strong);
  border-radius: 0;
  background: var(--pm-card);
  color: var(--pm-ink);
  font-size: 24rpx;
  box-sizing: border-box;
}

.sample-input.caption {
  width: 100%;
  margin-bottom: 10rpx;
}

.sample-input.sort {
  width: 96rpx;
  text-align: center;
}

.sample-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sample-sort-label {
  flex-shrink: 0;
  color: var(--pm-ink-3);
  font-family: var(--pm-mono);
  font-size: 22rpx;
}

.sample-switch {
  flex-shrink: 0;
  margin: 0 -6rpx;
  transform: scale(0.7);
}

.sample-save {
  background: var(--pm-primary);
  color: var(--pm-card);
  border: 1rpx solid var(--pm-primary);
}

.sample-remove {
  background: var(--pm-card);
  color: var(--pm-danger);
  border: 1rpx solid var(--pm-danger);
}
