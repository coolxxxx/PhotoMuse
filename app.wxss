/* app.wxss 全局样式文件 —— PhotoMuse Editorial 设计令牌（品牌蓝 × 杂志纸面）
   仅保留实际被页面引用的全局样式：reset / --pm-* 令牌 / .loading / .empty-state / 滚动条。
   v1.0 模板遗留的工具类（.btn*/.card/.input/h1-h3/.text-*/.mt*/.mb*/.list*/.icon/.tag*/.modal*/.fade-in/.container
   及旧绿色变量）经全量 wxml 反查零引用，已于本次清理移除（tests/static/check-visual-integrity.js 守护）。 */

/* 重置样式 */
page, view, text, image, button, input, textarea {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 全局变量：PhotoMuse Editorial 令牌（其他页面直接 var() 引用） */
page {
  --pm-primary:#1976D2; --pm-primary-deep:#0D47A1; --pm-primary-soft:#E8F1FB; --pm-primary-line:#BAD3F0;
  --pm-ink:#1B1F24; --pm-ink-2:#565B63; --pm-ink-3:#9AA0A8; --pm-ink-4:#C9CDD3;
  --pm-bg:#FAFAF9; --pm-card:#FFFFFF; --pm-card-soft:#F4F4F1;
  --pm-hairline:#E7E5E0; --pm-hairline-strong:#D8D6D0;
  --pm-success:#2E6B3F; --pm-success-soft:#EAF2EC; --pm-warning:#C66A2E; --pm-warning-soft:#F7EFE6; --pm-danger:#B23A3A; --pm-danger-soft:#F6EAEA;
  --pm-radius:6rpx; --pm-radius-card:8rpx;
  --pm-serif:Georgia,'Nimbus Roman','Songti SC','STSong',SimSun,serif;
  --pm-mono: ui-monospace, 'SF Mono', Menlo, Consolas, 'Courier New', monospace;
  --pm-shadow-card:0 2rpx 12rpx rgba(27,31,36,0.05);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--pm-bg);
  color: var(--pm-ink);
  font-size: 32rpx;
  line-height: 1.5;
}

/* 加载态（detail 等页使用） */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  width: 100%;
}

/* 空状态（index/detail/admin 使用） */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: var(--pm-ink-3);
}

.empty-state-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 32rpx;
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 6rpx;
  height: 6rpx;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--pm-hairline-strong);
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--pm-ink-4);
}
