/* app.wxss 全局样式文件 */

/* 重置样式 */
page, view, text, image, button, input, textarea {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 全局变量 */
page {
  --primary-color: #4CAF50;
  --primary-light: #81C784;
  --primary-dark: #388E3C;
  --secondary-color: #2196F3;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #e0e0e0;
  --background-color: #f0f0f0;
  --white: #ffffff;
  --success-color: #4CAF50;
  --warning-color: #FF9800;
  --error-color: #F44336;
  --info-color: #2196F3;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--background-color);
  color: var(--text-primary);
  font-size: 32rpx;
  line-height: 1.5;
}

/* 容器样式 */
.container {
  width: 100%;
  min-height: 100vh;
  padding: 0;
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 28rpx 60rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  text-decoration: none;
  transition: all 0.3s ease;
  margin: 10rpx 0;
}

.btn-primary {
  background-color: var(--primary-color);
  color: var(--white);
}

.btn-primary:active {
  background-color: var(--primary-dark);
}

.btn-secondary {
  background-color: var(--white);
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

.btn-secondary:active {
  background-color: var(--primary-light);
  color: var(--white);
}

.btn-disabled {
  background-color: var(--text-light);
  color: var(--white);
  opacity: 0.6;
  pointer-events: none;
}

/* 卡片样式 */
.card {
  background-color: var(--white);
  border-radius: 12rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
  transition: border-color 0.3s ease;
}

.input:focus {
  outline: none;
  border-color: var(--primary-color);
}

.input-disabled {
  background-color: var(--background-color);
  color: var(--text-light);
  pointer-events: none;
}

/* 标题样式 */
h1 {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--text-primary);
}

h2 {
  font-size: 42rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
}

h3 {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--text-primary);
}

/* 文本样式 */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-light {
  color: var(--text-light);
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

/* 间距样式 */
.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  width: 100%;
}

/* 列表样式 */
.list {
  width: 100%;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

/* 图标样式 */
.icon {
  width: 44rpx;
  height: 44rpx;
  display: inline-block;
  vertical-align: middle;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-primary {
  background-color: var(--primary-light);
  color: var(--primary-dark);
}

.tag-success {
  background-color: #E8F5E9;
  color: var(--success-color);
}

.tag-warning {
  background-color: #FFF3E0;
  color: var(--warning-color);
}

.tag-error {
  background-color: #FFEBEE;
  color: var(--error-color);
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-content {
  background-color: var(--white);
  border-radius: 12rpx;
  width: 80%;
  max-width: 600rpx;
  padding: 40rpx;
}

.modal-header {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-body {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 30rpx;
  text-align: center;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
}

.modal-footer .btn {
  flex: 1;
  margin: 0 10rpx;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: var(--text-light);
}

.empty-state-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 32rpx;
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 6rpx;
  height: 6rpx;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--text-light);
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

/* 响应式适配 */
@media screen and (min-width: 768px) {
  page {
    font-size: 14px;
  }
  .container {
    max-width: 768px;
    margin: 0 auto;
    box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.1);
  }
}